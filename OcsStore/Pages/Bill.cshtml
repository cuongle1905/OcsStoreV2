@page "/bill"
@using OcsStore.Models
@model OcsStore.Pages.BillModel
@{
    bool isNewBill = Model.Bill.Id == 0;
}
<style>
</style>

<div id="top-section" class="ms-auto me-auto" style="width: 24rem;">
</div>

<div id="total-section" class="mt-2"></div>

@(
Html.DevExtreme().DataGrid<BillDetailView>()
    .ID("main-grid")
    @* .DataSource(d => d.Mvc().Controller("Sales").LoadAction("GetNewBillDetails").LoadMethod("POST")) *@
    .RemoteOperations(false)
    .ShowBorders(true)
    .ShowRowLines(true)
    .WordWrapEnabled(true)
    .Sorting(s => s.Mode(GridSortingMode.None))
    .Paging(p => p.Enabled(true).PageSize(15))
    .OnContentReady("defaultOnGridContentReady")
    .Columns(columns =>
    {
        columns.AddFor(m => m.ItemName).Caption("Tên hàng").Width(125).Alignment(HorizontalAlignment.Left).FixedPosition(HorizontalEdge.Left).Fixed(true).AllowEditing(true);
        var col = columns.AddFor(m => m.Quantity).Caption("Số lượng").Width(55).Alignment(HorizontalAlignment.Right).SetCellValue("calculateRowTotal");
        GridUI.FormatNumberColumn(col, true);

        columns.AddFor(m => m.Unit).Caption("Đơn vị").Width(68).Alignment(HorizontalAlignment.Left)
            .Lookup(lookup => lookup
                .DataSource(ds => ds.Mvc().Controller("Item").LoadAction("GetUnits").LoadMethod("POST").Key("Id"))
                .ValueExpr("Id")
                .DisplayExpr("Name")
                .AllowClearing(false)
            )
            .EditorOptions(new { acceptCustomValue = false, searchEnabled = false });
            
        col = columns.AddFor(m => m.Price).Caption("Giá").Width(64).Alignment(HorizontalAlignment.Right).SetCellValue("calculateRowTotal");
        GridUI.FormatNumberColumn(col);

        columns.AddFor(m => m.Value).Caption("Thành tiền").Width(70).Alignment(HorizontalAlignment.Right).Format("#,##0").AllowEditing(false);

        @* columns.AddFor(m => m.Note).Caption("Ghi chú").Width(140).Alignment(HorizontalAlignment.Left); *@
    })
    .Editing(e => e.AllowUpdating(isNewBill).Mode(GridEditMode.Batch))
    .Summary(s => s
        .TotalItems(items =>
        {
            items.AddFor(m => m.Value)
                 .SummaryType(SummaryType.Sum)
                 .DisplayFormat("{0}")
                 .ValueFormat("#,##0");
        })
        .RecalculateWhileEditing(true) // Crucial for dynamic total calculation
    )
)

<div id="popup-container"></div>

@(
Html.DevExtreme().DataGrid<SaleItemView>()
    .ID("sale-items-grid")
    .RemoteOperations(false)
    .ShowBorders(true)
    .ShowRowLines(true)
    .WordWrapEnabled(true)
    .Sorting(s => s.Mode(GridSortingMode.None))
    .Paging(p => p.Enabled(true).PageSize(15))
    .OnContentReady("defaultOnGridContentReady")
    .Columns(columns =>
    {
        columns.AddFor(m => m.Selected).Caption("Chọn").Width(50).Fixed(true).FixedPosition(HorizontalEdge.Left).AllowEditing(true);

        columns.AddFor(m => m.ItemName).Caption("Hàng hóa").Width(130).Fixed(true).FixedPosition(HorizontalEdge.Left).AllowEditing(false);

        var col = columns.AddFor(m => m.LastProcessingQuantity).Caption("Số lượng trộn cuối (kg)").Format("#,##0").Width(80).AllowEditing(false);
        GridUI.FormatNumberColumn(col);

        col = columns.AddFor(m => m.Soh).Caption("Tồn kho (kg)").Format("#,##0").Width(70).AllowEditing(false);
        GridUI.FormatNumberColumn(col);
    })
    .Editing(e => e.AllowUpdating(true).Mode(GridEditMode.Batch))
)

<script>
    var customerSelectBox;
    var debitCheckBox;
    var bill = @Html.Raw(Json.Serialize(Model.Bill));
    var billDetails = @Html.Raw(Json.Serialize(Model.BillDetails));
    var customers = @Html.Raw(Json.Serialize(Model.Customers));
    var saleItems = @Html.Raw(Json.Serialize(Model.SaleItems));
    var isNewBill = @(isNewBill);
    pageTitle = isNewBill ? "Tạo đơn hàng" : "Đơn hàng #@(Model.Bill.Id)";
    var addDataPopup;
    var customerId;
    var dateBox;
    var timeBox;
    var grid;
    let vatNumberBox;
    var vatPercent = 0;
    let vatDiv;
    let totalDiv;

    $(function () {
        grid = $("#main-grid").dxDataGrid("instance");
        
        const totalSection = $("#total-section");
        $("#main-grid").first().append(totalSection);

        const totalContainer = appendFlexContainer({ container: totalSection, gap: 4 });
        totalContainer.addClass("justify-content-end pe-2");
        vatNumberBox = appendNumberField({ id: "vat-box", container: totalContainer, title: "VAT %", suffix: "%", width: "6rem", decimals: 0, onValueChanged: vatChanged });

        vatDiv = appendLabelField({ container: totalContainer, title: "VAT" });
        vatDiv.addClass("bold text-end");
        vatDiv.text("0");

        totalDiv = appendLabelField({ container: totalContainer, title: "Tổng cộng" });
        totalDiv.addClass("bold text-end");
        totalDiv.text("0");

        if (isNewBill) {
            addButton = appendButtonToGrid({style: "text", position: "top", onClick: showAddItemPopup});
            appendUndoSaveButtonsToGrid();
        } else {
            appendButtonToGrid({ gridId: "main-grid", level: 2, action: "delete", width: "50%", text: "Hủy", onClick: deleteData });
        }

        itemsGrid = $("#sale-items-grid").dxDataGrid("instance");

        const topSection = $("#top-section");
        $("#main-grid").first().prepend(topSection);

        const dateTimeBoxes = appendDateTimeFields({ container: topSection, dateWidth: "14rem", timeWidth: "10rem", disabled: !isNewBill });
        dateBox = dateTimeBoxes.dateBox;
        timeBox = dateTimeBoxes.timeBox;

        const customerContainer = appendFlexContainer({ container: topSection });
        customerSelectBox = appendSelectField({ id: "customer-select-box", container: customerContainer, width: "14rem", title: "Chọn khách hàng", dataSource: customers, onValueChanged: customerChanged, acceptCustomValue: true, disabled: !isNewBill });

        debitCheckBox = appendCheckField( { id: "debit-check-box", container: customerContainer, text: "Ghi nợ", width: "5rem", disabled: !isNewBill } );

        $("#sale-items-grid").css("visibility", "hidden");
        addDataPopup = $("#popup-container").dxPopup({
            width: "auto",
            height: "auto",
            visible: false,
            dragEnabled: true,
            hideOnOutsideClick: true,
            showTitle: true,
            title: "Chọn sản phẩm",
            contentTemplate: function() {
                return $("<div />").append($("#sale-items-grid"));
            },
            toolbarItems: [{
                widget: "dxButton",
                toolbar: "bottom",
                location: "center",
                options: {
                    width: "auto",
                    height: "auto",
                    text: "Bỏ qua",
                    stylingMode: "outlined",
                    onClick: function() {
                        addDataPopup.hide();
                    }
                }
            }, {
                widget: "dxButton",
                toolbar: "bottom",
                location: "center",
                options: {
                    width: "auto",
                    height: "auto",
                    text: "Thêm vào đơn hàng",
                    stylingMode: "contained",
                    onClick: addItems
                }
            }]
        }).dxPopup("instance");
        
        loadBill();
    });

    function loadBill() {
        if (!isNewBill) {
            const date = new Date(bill.Date);
            console.log("loadBill date", date);
            dateBox.option("value", date);

            const time = bill.Time.split(':');
            date.setHours(time[0], time[1]);
            timeBox.option("value", date);

            customerSelectBox.option("value", bill.Customer);
            debitCheckBox.option("value", !bill.Paid);

            vatNumberBox.option("value", bill.VatPercent);
        }
        grid.option("dataSource", billDetails);
    }

    function customerChanged(e) {
        customerId = e.value;
    }

    function vatChanged(e) {
        vatPercent = e.value;
        updateTotal();
    }

    function updateTotal() {
        const sum = billDetails.reduce((total, detail) => total + detail.Value, 0);
        const vat = Math.round(sum * vatPercent / 100);
        vatDiv.text(vat.toLocaleString());
        const total = sum + vat;
        totalDiv.text(total.toLocaleString());
    }

    function showAddItemPopup() {
        $("#sale-items-grid").css("visibility", "visible");
        const filteredItems = saleItems.filter(i => billDetails.find(j => j.Item == i.Item) == undefined);
        for (const item of filteredItems) {
            item.Selected = false;
        }
        itemsGrid.option("dataSource", filteredItems);
        addDataPopup.show();
    }

    function addItems() {
        var items = getGridSelectedRowData(itemsGrid);
        for (const item of items) {
            var billDetail = {};
            billDetail.Item = item.Item;
            billDetail.ItemName = item.ItemName;
            billDetail.Unit = item.Unit;
            billDetail.Quantity = Math.min((item.LastProcessingQuantity != null ? item.LastProcessingQuantity : 0), item.Soh) / item.BuExchange;
            billDetail.Price = (item.SalePrice != null ? item.SalePrice : 0);
            billDetail.Discount = 0;
            billDetail.Value = billDetail.Quantity * billDetail.Price;
            billDetails.push(billDetail);
        }
        console.log("new billDetails", billDetails);

        grid.option("dataSource", billDetails);
        addDataPopup.hide();
        updateTotal();
    }

    function calculateRowTotal(newData, value, currentRowData) {
        // 1. Update the field that triggered the change (e.g., Quantity or UnitPrice)
        this.defaultSetCellValue(newData, value);

        // 2. Derive dependent values
        var quantity = newData.Quantity !== undefined ? newData.Quantity : currentRowData.Quantity;
        var price = newData.Price !== undefined ? newData.Price : currentRowData.Price;

        // 3. Set the calculated field
        newData.Value = quantity * price;
    }

    function save() {
        if (customerId == undefined) {
            DevExpress.ui.dialog.alert(`Hãy chọn Khách hàng.`, "Cảnh báo");
            return;
        }

        var details = [];
        let rows = grid.getVisibleRows();
        for (const row of rows) {
            if (row.rowType == "data" && row.data.Quantity > 0) {
                if (row.data.Price <= 0) {
                    DevExpress.ui.dialog.alert(`Hãy nhập vào Giá cho sản phẩm '${row.data.ItemName}'.`, "Cảnh báo");
                    return;
                }
                details.push(row.data);
            }
        }
        // console.log(details);

        if (details.length == 0) {
            DevExpress.ui.dialog.alert("Hãy nhập vào chi tiết bán hàng.", "Cảnh báo");
            return;
        }

        DevExpress.ui.dialog.confirm("<i>Bạn có chắc chắn lưu thông tin?</i>", "Xác nhận").then(function(dialogResult) {
            if (dialogResult) {
                const bill = {};
                bill.Id = 0;
                bill.Customer = customerId;
                bill.Date = $("#date-box").dxDateBox("instance").option("value").toISOString();
                bill.Time = $("#time-box").dxDateBox("instance").option("text");
                bill.Paid = !debitCheckBox.option("value");
                bill.VatPercent = vatPercent;

                $.ajax({
                    url: '@Url.Action("SaveBill", "Sales")',
                    method: "POST",
                    data: { bill: bill, details: details },
                    success: function (result) {
                        DevExpress.ui.dialog.alert("Đã lưu dữ liệu.", "Thông báo").then(function(dialogResult) {
                            location.href = "/sales";
                        });
                    },
                    error: handleAjaxError
                });
            }
        });
    }

    function deleteData() {
        DevExpress.ui.dialog.confirm("<i>Bạn có chắc chắn hủy đơn hàng?</i>", "Xác nhận").then(function(dialogResult) {
            if (dialogResult) {
                $.ajax({
                    url: '@Url.Action("DeleteBill", "Sales")',
                    method: "POST",
                    data: { id: bill.Id },
                    success: function (result) {
                        DevExpress.ui.dialog.alert("Đã hủy đơn hàng.", "Thông báo").then(function(dialogResult) {
                            location.href = "/sales";
                        });
                    },
                    error: handleAjaxError
                });
            }
        });
    }
</script>