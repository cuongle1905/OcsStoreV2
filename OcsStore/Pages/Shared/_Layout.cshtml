<!DOCTYPE html>
<html>
@using Microsoft.AspNetCore.Http.Extensions
@{
    bool hasToken = !string.IsNullOrEmpty(Session.Token(Context.Request));
    bool isAdmin = Session.IsAdmin(Context.Request);
    string sourceUrl = Context.Request.Query["SourceUrl"].ToString();

    string itemGroupId = Context.Request.Query["ItemGroup"].ToString();
    if (string.IsNullOrEmpty(itemGroupId) || itemGroupId == "null")
        itemGroupId = "1";

    int loginSession = Session.LoginSession(Context.Request);
    if (!hasToken && (Context.Request.Path != "/" && Context.Request.Path != "/index"))
    {
        Context.Response.Redirect("/");
    }
    else if (Context.Request.GetDisplayUrl().Contains("localhost"))
    {
        loginSession++;
        Session.SetLoginSession(Context.Request, loginSession);
    }
}
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="description" content="">
    <meta name="author" content="">
    <title>OcsStore</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link href="https://fonts.googleapis.com/css?family=Roboto" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Roboto+Condensed" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wdth,wght@75,700;100,700&amp;display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

    <link href="~/css/devextreme/bootstrap.css" rel="stylesheet" />
    <link href="~/css/devextreme/dx.light.css" rel="stylesheet" />

    <script src="~/js/devextreme/jquery.js"></script>
    <script src="~/js/devextreme/bootstrap.js"></script>

    <script src="~/js/devextreme/dx.all.js"></script>

    <script src="~/js/devextreme/aspnet/dx.aspnet.mvc.js"></script>
    <script src="~/js/devextreme/aspnet/dx.aspnet.data.js"></script>

    <link href="~/css/devextreme/bootstrap.css" rel="stylesheet" />
    <link href="~/css/devextreme/dx.light.css" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css?v@(loginSession)" />
    <link rel="stylesheet" href="~/css/controls.css?v@(loginSession)" />
    <link rel="stylesheet" href="~/css/common.css?v@(loginSession)" />

    <script src="~/js/common.js?v@(loginSession)"></script>

    <link rel="preconnect" href="https://rsms.me/">
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css">
    
    @RenderSection("HeadSection", false)
</head>
<body spellcheck="false">
    <script>
        const True = true;
        const False = false;
        const isAdmin = @(isAdmin);
        var isShowingUserMenu = false;
        var isShowingMobileMenu = false;
        var pageTitle = "";
        var goBackUrl = "/@(sourceUrl)";
        var itemGroupId = @(itemGroupId);
        var isDataExpanded = false;
        goBackAfterSaving = false;
        
        function menuContainerOnClick() {
            console.log("menuContainerOnClick");
            if (!isClickingMenuItem)
                showMenu(false);
        }

        function menuButtonClick() {
            showMenu(!isShowingMenuContent);
        }

        function menuItemClick(e) {
            console.log("menuItemClick");
            isClickingMenuItem = true;
            window.location.href = e.itemData.Link;
            showMenu(false);
        }

        function showMenu(show) {
            isShowingMenuContent = show;
            //var menu = $("#menu").dxMenu("instance").option("visible", show);
            $("#menu-container").css("visibility", show ? "visible" : "hidden");
            if (!show)
                $(':focus').blur();
        }

        function showHideMenu() {
            isShowingMobileMenu = !isShowingMobileMenu;
            $("#home-left-panel").css("visibility", isShowingMobileMenu ? "visible" : "hidden");
        }

        function menuItemTemplate(itemData, itemIndex, itemElement) {
            var div = $("<div>").addClass("menu-item").appendTo(itemElement);
            if (itemData.Id == 0) {
                div.html("<i class='dx-icon-menu'></i>")
            } else {
                div.text(itemData.text);
            }
        }

        function goBack() {
            history.go(-1);
        }

        function displayUserMenu() {
            var popup = $("#user-menu-popup").dxPopup("instance");
            if (!isShowingUserMenu) {
                popup.show();
                isShowingUserMenu = true;
            }
        }

        function userMenuPopupOnHidden() {
            setTimeout(function () {
                isShowingUserMenu = false;
            }, 300)
        
            $("#user-menu-popup").dxPopup("instance").hide();
            var popup = $("#change-user-password-popup").dxPopup("instance");
            popup.show();
        }

        function changeUserPasswordPopupOnShow() {
            var form = $("#change-user-password-popup-form").dxForm("instance");
            form.resetValues();
        }

        function saveUserPassword() {
            var form = $("#change-user-password-popup-form").dxForm("instance");
            var validationResult = form.validate();
            if (!validationResult.isValid)
                return;

            var currentPassword = form.getEditor("CurrentPassword").option("value").trim();
            var newPassword = form.getEditor("NewPassword").option("value").trim();
            var retypePassword = form.getEditor("RetypePassword").option("value").trim();
            if (newPassword == currentPassword) {
                DevExpress.ui.dialog.alert("Mật khẩu mới không được trùng với Mật khẩu cũ.", "Cảnh báo");
                return;
            }
            if (retypePassword != newPassword) {
                DevExpress.ui.dialog.alert("Gõ lại mật khẩu chưa đúng.", "Cảnh báo");
                return;
            }
            $.ajax({
                url: '@Url.Action("UpdatePassword", "Token")',
                method: "POST",
                data: { "newPassword": newPassword, "oldPassword": currentPassword },
                success: function (result) {
                    isSavingUser = false;
                    DevExpress.ui.dialog.alert("Đã cập nhật Mật khẩu thành công.", "Thông báo");
                    $("#change-user-password-popup").dxPopup("instance").hide();
                },
                error: function (xhr, status, error) {
                    console.log(xhr);
                    if (xhr.responseText == "incorrect old password") {
                        DevExpress.ui.dialog.alert("Mật khẩu cũ không chính xác.", "Cảnh báo");
                        return;
                    }
                    isSavingUser = false;
                    DevExpress.ui.dialog.alert("Không thể cập nhật Mật khẩu. Xin hãy thử lại sau.", "Cảnh báo");
                }
            });
        }

        function logout() {
            DevExpress.ui.dialog.confirm("<i>Bạn có chắc chắn muốn Logout?</i>", "Xác nhận").then(function(dialogResult) {
                if (dialogResult) {
                    $.ajax({
                        url: '@Url.Action("Logout", "Token")',
                        method: "POST",
                        success: function (result) {
                            location.href = 'Index';
                        },
                        error: function (xhr, status, error) {
                        }
                    });
                }
            });
        }

        function expandCollapseButtonClicked() {
            isDataExpanded = !isDataExpanded
            const buttonIcon = $("#expand-collapse-button i");
            buttonIcon.removeClass(isDataExpanded ? "bi-arrows-expand-vertical" : "bi-arrows-collapse-vertical");
            buttonIcon.addClass(isDataExpanded ? "bi-arrows-collapse-vertical" : "bi-arrows-expand-vertical");
            
            if (typeof expandCollapseData === "function") {
                expandCollapseData();
            }
        }

    </script>
    <div style="position: fixed; left: 0; right: 0; top: 0; z-index: 1000">
        <div id="top-bar" class="d-flex align-items-center p-2">
            @if (hasToken)
            {
                <a id="menu-icon" href="#" class="menu-link" onclick="showHideMenu()"><img src="~/images/logo_text_blue.png" style="width: 30px; height: 30px"/></a>
                <div><a id="go-back" class="back-arrow" href="#"><i class="bi bi-arrow-left-short"></i></a></div>
            }
            else 
            {
                <a id="menu-icon" href="/" class="menu-link"><img src="~/images/logo_text_blue.png" style="width: 30px; height: 30px"/></a>
            }
            <div id="page-title" class="text-center flex-fill">
                UNI COFFEE
            </div>
            @if (hasToken)
            {
                <a id="expand-collapse-button" href="#" class="me-2" onclick="expandCollapseButtonClicked()"><i class="bi bi-arrows-expand-vertical"></i></a>
                <a id="logout-button" href="#" onclick="logout()"><i class="bi bi-box-arrow-right"></i></a>
            }
        </div>
    </div>
    @if (hasToken)
    {
        <div id="home-left-panel">
        @(Html.DevExtreme().ScrollView()
            .ID("home-left-scrollview")
            .ScrollByContent(true)
            .ScrollByThumb(true)
            .ShowScrollbar(ShowScrollbarMode.Never)
            .Content(@<text>
                <div id="home-left-scrollview-content" style="">
                @if (hasToken)
                {
                    <a class="menu-link" href='/'>
                        <div class="home-left-item">
                            <i class="dx-icon-home"></i>
                            <div class="home-left-item-text">
                                <span>Màn hình chính</span>
                            </div>
                        </div>
                    </a>
                    <a class="menu-link" href='~/stock'>
                        <div class="home-left-item">
                            <i class="dx-icon-box"></i>
                            <div class="home-left-item-text">
                                <span>Tồn kho</span>
                            </div>
                        </div>
                    </a>
                    <a class="menu-link" href='~/receiving'>
                        <div class="home-left-item">
                            <i class="dx-icon-cart"></i>
                            <div class="home-left-item-text">
                                <span>Nhập kho</span>
                            </div>
                        </div>
                    </a>
                    <a class="menu-link" href='~/processing'>
                        <div class="home-left-item">
                            <i class="dx-icon-preferences"></i>
                            <div class="home-left-item-text">
                                <span>Chế biến</span>
                            </div>
                        </div>
                    </a>
                    <a class="menu-link" href='~/sales'>
                        <div class="home-left-item">
                            <i class="dx-icon-coffee"></i>
                            <div class="home-left-item-text">
                                <span>Bán hàng</span>
                            </div>
                        </div>
                    </a>
                    <a class="menu-link" href='~/customer'>
                        <div class="home-left-item">
                            <i class="dx-icon-box"></i>
                            <div class="home-left-item-text">
                                <span>Khách hàng - Công nợ</span>
                            </div>
                        </div>
                    </a>
                    <a class="menu-link" href='~/inventory'>
                        <div class="home-left-item">
                            <i class="dx-icon-coffee"></i>
                            <div class="home-left-item-text">
                                <span>Kiểm kê</span>
                            </div>
                        </div>
                    </a>
                    <a class="menu-link" href='~/report'>
                        <div class="home-left-item">
                            <i class="dx-icon-chart"></i>
                            <div class="home-left-item-text">
                                <span>Báo cáo</span>
                            </div>
                        </div>
                    </a>
                    <a class="menu-link" href='~/datamanagement'>
                        <div class="home-left-item">
                            <i class="bi bi-stack"></i>
                            <div class="home-left-item-text">
                                <span>Quản lý dữ liệu</span>
                            </div>
                        </div>
                    </a>
                }
                </div>
            </text>)
        )
    </div>
    }
    <main id="main-content">
        @RenderBody()
    </main>
@*<a id="scroll-to-top-button" class="my-floating-button" href="#" onclick="scrollToTop()"><i class="dx-icon-chevronup"></i></a>*@

<script>
    $(function () {
    console.log("loginSession", @(loginSession));
        $("#page-title").html(pageTitle);

        if (goBackUrl != "/") {
            $("#go-back").attr("href", goBackUrl);
        } else {
            $("#go-back").css("visibility", "hidden");
        }

        // console.log("location.href", location.href);
        let links = $("#home-left-scrollview-content a.menu-link");
        
        for (var i = 1; i < links.length; i++) {
            const link = links[i];
            const href = $(link).attr("href");
            console.log("link", link, "href", href, "location.href", location.href);
            if (location.href.toLowerCase().replace("/new?", "?").replace("/stockcard", "/stock").replace("/items", "/datamanagement").includes(href)) {
                // console.log("link.children[0]", link.children[0]);
                link.children[0].classList.add("item-active");
                break;
            }
        }
    if (location.href == "" || location.href == "#") {
            links[0].children[0].classList.add("item-active");
        } else {
        }
    });
</script>
</body>

</html>