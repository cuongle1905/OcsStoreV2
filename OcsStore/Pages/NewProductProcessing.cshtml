@page "/productprocessing/new"
@using OcsStore.Models
@model OcsStore.Pages.NewProductProcessingModel
@{
}
<style>
</style>

<div id="top-section" class="ms-auto me-auto pt-3" style="width: 24rem;">
</div>

@(
Html.DevExtreme().DataGrid<ProcessingInputView>()
    .ID("main-grid")
    .DataSource(d => d.Mvc().Controller("Processing").LoadAction("GetNewDetails").LoadMethod("POST").LoadParams(new { ItemId = new JS("function () { return itemId; }") }))
    .RemoteOperations(false)
    .ShowBorders(true)
    .ShowRowLines(true)
    .WordWrapEnabled(true)
    .Sorting(s => s.Mode(GridSortingMode.None))
    .Paging(p => p.Enabled(true).PageSize(15))
    .OnContentReady("defaultOnGridContentReady")
    .Columns(columns =>
    {
        columns.AddFor(m => m.ItemName).Caption("Nguyên liệu").Width(125).Alignment(HorizontalAlignment.Left).AllowEditing(false).CellTemplate(new JS("stockItemTableCellTemplate"));
        columns.AddFor(m => m.Quantity).Caption("Số lượng").Width(60).Alignment(HorizontalAlignment.Right).CustomizeText("emptyZeroNumberCellText")
            .DataType(GridColumnDataType.Number)
            .Format("#,##0.0")
            .EditorOptions(new { format = "#,##0.0", min = 0, max = 10000, step = 1, showSpinButtons = false })
            .CellTemplate(new JS("stockItemTableCellTemplate"));

        columns.AddFor(m => m.UnitName).Caption("").Width(40).Alignment(HorizontalAlignment.Left).AllowEditing(false).CellTemplate(new JS("stockItemTableCellTemplate"));
        columns.AddFor(m => m.Soh).Caption("Tồn kho").Width(60).Alignment(HorizontalAlignment.Right).CellTemplate(new JS("sohCellTemplate")).Format("#,##0.00").AllowEditing(false);
    })
    .Editing(e => e.AllowUpdating(true).Mode(GridEditMode.Batch).SelectTextOnEditStart(true))
    .RepaintChangesOnly(true)
)

<script>
    pageTitle = "Trộn mới";
    goBackUrl = "/productprocessing";
    var items = @Html.Raw(Json.Serialize(Model.Items));
    let itemId;
    let itemQuantity = 0.0;
    var saveButtonContainer;

    $(function () {
        const topSection = $("#top-section");
        $("#main-grid").first().prepend(topSection);

        appendDateTimeFields({ container: topSection, dateWidth: "12rem" });

        const itemQuantityContainer = appendFlexContainer({ container: topSection });

        appendSelectField({ id: "item-select-box", container: itemQuantityContainer, width: "12rem", title: "Chọn sản phẩm", dataSource: items, onValueChanged: itemChanged });

        appendNumberField({ id: "item-quantity", container: itemQuantityContainer, title: "Số lượng", suffix: "Kg", decimals: 1, onValueChanged: itemQuantityChanged });
        $("#item-quantity").parent().css("visibility", "hidden");

        const saveButton = appendSaveButtonToGrid();
        appendSaveButtonToGrid({ text: "Bán hàng", icon: "bi bi-arrow-right", onClick: function() { save(true); } });

        saveButtonContainer = saveButton.element().parent();
        saveButtonContainer.css("visibility", "hidden");
    });

    function itemChanged(e) {
        itemId = e.value;
        $("#item-quantity").parent().css("visibility", "visible");
        saveButtonContainer.css("visibility", "visible");
        reloadData();
    }

    function itemQuantityChanged(e) {
        itemQuantity = $("#item-quantity").dxNumberBox("instance").option("value");
        let grid = $("#main-grid").dxDataGrid("instance");
        let rows = grid.getVisibleRows();
        let materialQuantity = 0;
        for (var i = 0; i < rows.length; i++) {
            const row = rows[i];
            console.log(row.data); // The raw data object for this row
            if (row.rowType == "data") {
                materialQuantity = Math.round(itemQuantity * row.data.MaterialQuantity * 100) / 100;
                grid.cellValue(i, "Quantity", materialQuantity);
            }
        }
    }

    function sohCellTemplate(container, options) {
        stockItemTableCellTemplate(container, options);
        container.html(`<a class='text-link' href='#' onclick='sohClicked(${options.rowIndex});'><span>${options.text}</span></a>`);
    }

    function itemCellTemplate(container, options) {
        let cssColor = cssColorForItemType(options.data.ItemGroup);
        displayCell(container, options, "●", cssColor);
    }

    function sohClicked(rowIndex) {
        let grid = $("#main-grid").dxDataGrid("instance");
        let soh = grid.cellValue(rowIndex, "Soh");
        grid.cellValue(rowIndex, "Quantity", soh);
    }

    function save(goToSale) {
        let quantity = $("#item-quantity").dxNumberBox("instance").option("value");
        if (quantity == null || quantity <= 0) {
            DevExpress.ui.dialog.alert("Hãy nhập vào Số lượng.", "Cảnh báo");
            return;
        }

        let grid = $("#main-grid").dxDataGrid("instance");
        // grid.saveEditData();

        var details = []
        let rows = grid.getVisibleRows();
        let itemName = "";
        let materialQuantity = 0;
        for (var i = 0; i < rows.length; i++) {
            const row = rows[i];
            if (row.rowType == "data" && row.data.Quantity > 0) {
                const soh = (row.data.Soh != null ? row.data.Soh : 0);
                if (row.data.Quantity > soh) {
                    DevExpress.ui.dialog.alert(`[${row.data.ItemName}] Số lượng ${row.data.Quantity} vượt quá tồn kho ${soh}.`, "Cảnh báo");
                    return;
                }
                details.push(row.data);
            }
        }
        console.log(details);

        if (details.length == 0) {
            DevExpress.ui.dialog.alert("Hãy nhập vào số lượng nguyên liệu.", "Cảnh báo");
            return;
        }

        DevExpress.ui.dialog.confirm("<i>Bạn có chắc chắn lưu dữ liệu?</i>", "Xác nhận").then(function(dialogResult) {
            if (dialogResult) {
                let processing = {};
                processing.Date = $("#date-box").dxDateBox("instance").option("value").toISOString();
                processing.Time = $("#time-box").dxDateBox("instance").option("text");
                processing.Item = itemId;
                processing.Quantity = quantity;

                $.ajax({
                    url: '@Url.Action("Save", "Processing")',
                    method: "POST",
                    data: { processing: processing, details: details },
                    success: function (result) {
                        if (goToSale) {
                            location.href = `/sales/new?processing=${result}`; 
                        } else {
                            DevExpress.ui.dialog.alert("Đã lưu dữ liệu.", "Thông báo").then(function(dialogResult) {
                                location.href = goBackUrl;
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        console.log("xhr", xhr, "status", status, "error", error);
                        DevExpress.ui.dialog.alert("Có lỗi xảy ra. Vui lòng thử lại sau.", "Cảnh báo");
                    }
                });
            }
        });
    }
</script>