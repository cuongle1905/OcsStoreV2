@page
@using OcsStore.Models
@model OcsStore.Pages.MaterialsModel
@{
}
<style>
    #main-grid .detail-arrow.dx-button-has-icon .dx-button-content {
        padding: 4px;
    }
    #main-grid .dx-datagrid-group-opened, #main-grid .dx-datagrid-group-closed {
        padding-top: 2px;
    }
    #main-grid .dx-group-row td {
        padding-top: 2px;
        padding-bottom: 2px;
    }
    .cell-link-button .dx-icon {
        width: 14px;
        height: 14px;
    }
</style>

@(Html.DevExtreme().DataGrid<MaterialView>()
    .ID("main-grid")
    .DataSource(d => d.Mvc().Controller("Item").LoadAction("GetMaterialViews").LoadMethod("POST").LoadParams(new { GroupId = 3 }).OnLoaded("gridDataLoadedForUsedData"))
    .RemoteOperations(false)
    .ShowBorders(true)
    .ShowRowLines(true)
    .WordWrapEnabled(true)
    .Sorting(s => s.Mode(GridSortingMode.None))
    .Paging(p => p.Enabled(true).PageSize(15))
    .OnContentReady("defaultOnGridContentReady")
    .Columns(columns =>
    {
        columns.AddFor(m => m.ItemName).Caption("Tên hàng").Width(120).GroupIndex(0).GroupCellTemplate(new JS("groupCellTemplate"));
        columns.AddFor(m => m.Name).Caption("Nguyên liệu").Width(120).Fixed(true).FixedPosition(HorizontalEdge.Left);
        columns.AddFor(m => m.Quantity).Caption("Số lượng").Width(64).Format("#,##0.00");
        columns.AddFor(m => m.UnitName).Caption("").Width(40);
        columns.AddFor(m => m.LostPercent).Caption("Hao hụt").Width(64).Format("#,##0").CellTemplate(new JS("percentCellTemplate"));
    })
    .Editing(e => e.AllowUpdating(false))
)

<script>
    pageTitle = "Công thức chế biến";
    goBackUrl = "/datamanagement";

    $(function () {
        appendAddButtonToGrid("main-grid", "add-button", "Thêm", function() {
            location.href = "/material?sourceurl=materials&&group=" + itemGroupId;
        });
    });


    function groupCellTemplate(container, options) {
        console.log("groupCellTemplate options", options);
        const itemId = options.data.items[0].Item;
        const groupContent = $(`<div class='d-flex align-items-center ms-3'>${options.text}</div>`)
        container.append(groupContent);
        $("<div>").dxButton({
            text: "",
            icon: detailArrowIcon,
            stylingMode: "text",
            elementAttr: { class: "detail-arrow no-border-button cell-link-button" },
            onClick: function (e) {
                location.href = "/material?sourceurl=materials&&item=" + itemId;
            }
        }).appendTo(groupContent);
    }

</script>