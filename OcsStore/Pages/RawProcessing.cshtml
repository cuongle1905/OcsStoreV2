@page
@using OcsStore.Models
@model OcsStore.Pages.RawProcessingModel
@{
}

<script>
    dateRangeControl.fromDate = dateRangeControl.toDate.firstDateOfMonth();
</script>
<div id="top-section" class="ms-auto me-auto" style="width: 100%;">
</div>

@(
Html.DevExtreme().DataGrid<ProcessingInputView>()
    .ID("main-grid")
    .DataSource(d => d.Mvc().Controller("Processing").LoadAction("GetProcessingInputViews").LoadMethod("POST").Key("Id").LoadParams(new { ItemGroup = 2, ItemId = new JS("function() { return itemId; }"), FromDate = new JS("function() { return dateRangeControl.fromDate.toISOString(); }"), ToDate = new JS("function() { return dateRangeControl.toDate.toISOString(); }") }))
    .RemoteOperations(false)
    .ShowBorders(true)
    .ShowRowLines(true)
    .WordWrapEnabled(true)
    .Sorting(s => s.Mode(GridSortingMode.None))
    .Paging(p => p.Enabled(true).PageSize(20))
    .Pager(p => p.ShowPageSizeSelector(true).AllowedPageSizes([20, 30, 50]))
    .OnContentReady("onGridContentReadyExpandFirstGroup")
    .Columns(columns =>
    {
        columns.AddFor(m => m.Date).Caption("Ngày").Width(77).Alignment(HorizontalAlignment.Center).Format("dd/MM/yyyy");
        columns.AddFor(m => m.Time).Caption("Giờ").Width(42).Alignment(HorizontalAlignment.Center).CellTemplate(new JS("editTimeCellTemplate"));
        columns.AddFor(m => m.ItemName).Caption("Thành phẩm").Width(80).CellTemplate(new JS("itemCellTemplate"));
        columns.AddFor(m => m.MaterialQuantity).Caption("Nguyên liệu (kg)").Width(55).Format("#,##0.0");
        columns.AddFor(m => m.Quantity).Caption("Thành phẩm (kg)").Width(55).Format("#,##0.0");
        columns.AddFor(m => m.UserName).Caption("Người tạo").Width(50);
        columns.Add().Name("Action").Width(36).Alignment(HorizontalAlignment.Center).Fixed(true).FixedPosition(HorizontalEdge.Right).CellTemplate(new JS("deleteActionCellTemplate"));
    })
    .OnCellPrepared("onCellPreparedGroupFixedRightColumn")
    .Editing(e => e.AllowUpdating(false))
    .Paging(p => p.Enabled(true).PageSize(20))
    .Summary(s => s
        .TotalItems(items =>
        {
            items.AddFor(m => m.MaterialQuantity).SummaryType(SummaryType.Sum).DisplayFormat("{0}").ValueFormat("#,##0.0");
            items.AddFor(m => m.Quantity).SummaryType(SummaryType.Sum).DisplayFormat("{0}").ValueFormat("#,##0.0");
        })
    )
)

<script>
    pageTitle = "Rang";
    dataRowKeyFields = ["Processing"];
    deleteUrl = '@Url.Action("DeleteProcessing", "Processing")';
    editDateTimeUrl = '@Url.Action("EditDateTime", "Processing")';
    var itemGroupId = 2;
    var items = @Html.Raw(Json.Serialize(Model.Items));
    var itemId = 0;

    $(function () {
        mainGrid = $("#main-grid").dxDataGrid("instance");

        appendTopAddButtonToGrid({ onClick: function() {
            location.href = "/rawprocessing/new";
        }});
        
        const topSection = $("#top-section");
        $("#main-grid").first().prepend(topSection);

        const flexContainer = appendFlexContainer({ container: topSection, gap: 2 });
        appendSelectField({ id: "item-select-box", container: flexContainer, width: "10.4rem", title: "Thành phẩm", dataSource: items, onValueChanged: itemChanged });

        appendDateRangeControl({ container: flexContainer, onValueChanged: onDateRangeChanged })
    });

    function itemChanged(e) {
        itemId = e.value;
        mainGrid.refresh();
    }
    
    function onDateRangeChanged() {
        mainGrid.refresh();
    }

    function itemCellTemplate(container, options) {
        const cssColor = cssColorForItemType(options.data.ItemGroup);
        container.html(dotSymbolHtml(cssColor) + options.text);
    }

</script>