@page "/receiving"
@using OcsStore.Models
@model OcsStore.Pages.ReceivingsModel
@{
    bool isAdmin = Session.IsAdmin(Request);
}

<script>
    dateRangeControl.fromDate = dateRangeControl.toDate.firstDateOfMonth();
</script>
<div id="top-section" class="ms-auto me-auto" style="width: 100%;">
</div>
@(
Html.DevExtreme().DataGrid<ReceivingDetailView>()
    .ID("main-grid")
    .DataSource(d => d.Mvc().Controller("Receiving").LoadAction("GetReceivings").LoadMethod("POST").LoadParams(new { ItemId = new JS("function() { return itemId; }"), FromDate = new JS("function() { return dateRangeControl.fromDate.toISOString(); }"), ToDate = new JS("function() { return dateRangeControl.toDate.toISOString(); }") }).Key("Id"))
    .RemoteOperations(false)
    .ShowBorders(true)
    .ShowRowLines(true)
    .WordWrapEnabled(true)
    .Sorting(s => s.Mode(GridSortingMode.None))
    .Paging(p => p.Enabled(true).PageSize(20))
    .Pager(p => p.ShowPageSizeSelector(true).AllowedPageSizes([20, 30, 50]))
    .OnContentReady("onGridContentReadyExpandFirstGroup")
    .Columns(columns =>
    {
        columns.AddFor(m => m.Date).Caption("Ngày").Width(80).Alignment(HorizontalAlignment.Center).Format("dd/MM/yyyy")
            .GroupIndex(0).SortOrder(SortOrder.Desc).AutoExpandGroup(false).GroupCellTemplate(new JS("groupCellTemplateTextOnly"));
        columns.AddFor(m => m.Time).Caption("Giờ").Width(45).Alignment(HorizontalAlignment.Center).CellTemplate(new JS("editTimeCellTemplate"));
        columns.AddFor(m => m.ItemName).Caption("Hàng hóa").Width(110).Alignment(HorizontalAlignment.Left).CellTemplate(new JS("itemCellTemplate"));
        columns.AddFor(m => m.Quantity).Caption("Số lượng").Width(50).Alignment(HorizontalAlignment.Right).Format("#,##0");
        columns.AddFor(m => m.Price).Caption("Giá\n(đồng)").Width(65).HeaderCellTemplate(new JS("subLineHeaderCellTemplate")).Format("#,##0");
        columns.AddFor(m => m.Value).Caption("Thành tiền\n(x 1000đ)").Width(70).HeaderCellTemplate(new JS("subLineHeaderCellTemplate")).Fixed(true).FixedPosition(HorizontalEdge.Right).Format("#,##0");
        columns.Add().Name("Action").Width(30).Alignment(HorizontalAlignment.Center).Fixed(true).FixedPosition(HorizontalEdge.Right).CellTemplate(new JS("deleteActionCellTemplate"));
    })
    .OnCellPrepared("onCellPreparedGroupFixedRightColumn")
    .Editing(e => e.AllowUpdating(false))
    .Summary(s => s
        .GroupItems(items =>
        {
            items.AddFor(m => m.Value)
                 .SummaryType(SummaryType.Sum)
                 .DisplayFormat("{0}")
                 .ValueFormat("#,##0");
        })
        .TotalItems(items =>
        {
            items.AddFor(m => m.Value)
                 .SummaryType(SummaryType.Sum)
                 .DisplayFormat("{0}")
                 .ValueFormat("#,##0");
            items.AddFor(m => m.Quantity)
                 .SummaryType(SummaryType.Sum)
                 .DisplayFormat("{0}")
                 .ValueFormat("#,##0");
        })
    )
)

<script>
    pageTitle = "NHẬP KHO";
    deleteUrl = '@Url.Action("DeleteDetail", "Receiving")';
    editDateTimeUrl = '@Url.Action("EditDateTime", "Receiving")';
    var items = @Html.Raw(Json.Serialize(Model.Items));
    var itemId = 0;

    $(function () {
        mainGrid = $("#main-grid").dxDataGrid("instance");

        appendTopAddButtonToGrid({ onClick: function() {
            location.href = "receiving/new?sourceurl=receiving";
        }});

        const topSection = $("#top-section");
        $("#main-grid").first().prepend(topSection);
        
        const flexContainer = appendFlexContainer({ container: topSection, gap: 2 });
        appendSelectField({ id: "item-select-box", container: flexContainer, width: "10.4rem", title: "Hàng hóa", dataSource: items, onValueChanged: itemChanged });

        appendDateRangeControl({ container: flexContainer, onValueChanged: onDateRangeChanged })
    });

    function itemChanged(e) {
        itemId = e.value;
        mainGrid.refresh();
    }

    function onDateRangeChanged() {
        mainGrid.refresh();
    }

    function itemCellTemplate(container, options) {
        container.html(dotSymbolHtml("green") + options.text);
    }

    function setEditDateTimeParams(data, rowData) {
        data.Id = rowData.Receiving;
    }
</script>