@page "/receiving"
@using OcsStore.Models
@model OcsStore.Pages.ReceivingsModel
@{
    bool isAdmin = Session.IsAdmin(Request);
}

@(
Html.DevExtreme().DataGrid<ReceivingDetailView>()
    .ID("main-grid")
    .DataSource(d => d.Mvc().Controller("Receiving").LoadAction("GetReceivings").LoadMethod("POST").Key("Id"))
    .RemoteOperations(false)
    .ShowBorders(true)
    .ShowRowLines(true)
    .WordWrapEnabled(true)
    .Sorting(s => s.Mode(GridSortingMode.None))
    .Paging(p => p.PageSize(100))
    .Pager(p => p.Visible(false))
    .OnContentReady("gridContentReady")
    .Columns(columns =>
    {
        columns.AddFor(m => m.Date).Caption("Ngày").Width(80).Alignment(HorizontalAlignment.Center).Format("dd/MM/yyyy")
            .GroupIndex(0).SortOrder(SortOrder.Desc).AutoExpandGroup(false).GroupCellTemplate(new JS("groupCellTemplateTextOnly"));
        columns.AddFor(m => m.Time).Caption("Giờ").Width(45).Alignment(HorizontalAlignment.Center);
        columns.AddFor(m => m.ItemName).Caption("Hàng hóa").Width(110).Alignment(HorizontalAlignment.Left).CellTemplate(new JS("itemCellTemplate"));
        columns.AddFor(m => m.Quantity).Caption("Số lượng").Width(50).Alignment(HorizontalAlignment.Right).Format("#,##0");
        columns.AddFor(m => m.Price).Caption("Giá\n(đồng)").Width(65).HeaderCellTemplate(new JS("subLineHeaderCellTemplate")).Format("#,##0");
        columns.AddFor(m => m.Value).Caption("Thành tiền\n(x 1000đ)").Width(70).HeaderCellTemplate(new JS("subLineHeaderCellTemplate")).Fixed(true).FixedPosition(HorizontalEdge.Right).Format("#,##0");
        if (isAdmin)
        {
            columns.Add().Name("Action").Width(30).Alignment(HorizontalAlignment.Center).Fixed(true).FixedPosition(HorizontalEdge.Right).CellTemplate(new JS("deleteActionCellTemplate"));
        }
    })
    .OnCellPrepared("onCellPreparedGroupFixedRightColumn")
    .Editing(e => e.AllowUpdating(false))
    .Paging(p => p.Enabled(true).PageSize(100))
    .Summary(s => s
        .GroupItems(items =>
        {
            items.AddFor(m => m.Value)
                 .SummaryType(SummaryType.Sum)
                 .DisplayFormat("{0}")
                 .ValueFormat("#,##0");
        })
        .TotalItems(items =>
        {
            items.AddFor(m => m.Value)
                 .SummaryType(SummaryType.Sum)
                 .DisplayFormat("{0}")
                 .ValueFormat("#,##0");
        })
    )
)

<script>
    pageTitle = "NHẬP KHO";
    deleteUrl = '@Url.Action("DeleteDetail", "Receiving")';

    $(function () {
        appendTopAddButtonToGrid("#main-grid", function() {
            location.href = "receiving/new?sourceurl=receiving";
        });
    });

    function gridContentReady(e) {
        defaultOnGridContentReady(e);
        expandFirstTableGroup();
    }

    function itemCellTemplate(container, options) {
        container.html(dotSymbolHtml("green") + options.text);
    }

</script>