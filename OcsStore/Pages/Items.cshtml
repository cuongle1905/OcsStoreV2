@page
@using OcsStore.Models
@model OcsStore.Pages.ItemsModel
@{
}

<div id="top-section" class="pb-3">
</div>

<div id="tab-container" class="pb-3">
</div>

@(Html.DevExtreme().DataGrid<ItemManagementView>()
    .ID("main-grid")
    .DataSource(d => d.Mvc().Controller("Item").LoadAction("GetItemManagementViews").LoadMethod("POST").LoadParams(new { GroupId = new JS("function() { return itemGroupId; }"), MaterialIds = new JS("function() { return selectedMaterialIds; }") }).OnLoaded("gridDataLoadedForUsedData"))
    .RemoteOperations(false)
    .ShowBorders(true)
    .ShowRowLines(true)
    .WordWrapEnabled(true)
    .Sorting(s => s.Mode(GridSortingMode.None))
    .Paging(p => p.Enabled(false))
    .OnContentReady("defaultOnGridContentReady")
    .OnRowPrepared("onRowPreparedInactive")
    .OnInitNewRow("onInitNewRow")
    .Columns(columns =>
    {
        columns.AddFor(m => m.Name).Caption("Tên").Width(120).Alignment(HorizontalAlignment.Left).Fixed(true).FixedPosition(HorizontalEdge.Left);
        columns.AddFor(m => m.Form).Caption("Dạng").Width(50).Alignment(HorizontalAlignment.Left)
            .Lookup(lookup => lookup.DataSource(Model.ItemForms).ValueExpr("Id").DisplayExpr("Name"));

        columns.AddFor(m => m.Unit).Caption("Đơn vị").Width(70).Alignment(HorizontalAlignment.Left)
            .Lookup(lookup => lookup.DataSource(Model.Units).ValueExpr("Id").DisplayExpr("Name"));

        columns.AddFor(m => m.AllowSale).Caption("Hàng bán").Width(44);
        columns.AddFor(m => m.SalePrice).Caption("Giá bán").Width(64).Alignment(HorizontalAlignment.Right).Format("#,##0");
        columns.AddFor(m => m.Inactive).Caption("Không hiệu lực").Width(60);
        columns.Add().Name("Action").Width(36).Alignment(HorizontalAlignment.Center).Fixed(true).FixedPosition(HorizontalEdge.Right).CellTemplate(new JS("deleteActionCellTemplate"));
    })
    .Editing(e => e.AllowUpdating(true).Mode(GridEditMode.Batch).SelectTextOnEditStart(true).NewRowPosition(GridNewRowPosition.PageBottom))
    .OnEditorPreparing("defaultOnEditorPreparing")
    .RepaintChangesOnly(true)
)

<script>
    pageTitle = "Hàng hóa";
    goBackUrl = "/datamanagement";
    deleteUrl = '@Url.Action("Delete", "Item")';
    saveUrl = '@Url.Action("SaveItems", "Item")';
    let addButton;
    var selectedMaterialIds = [];

    $(function () {
        if (itemGroupId < 2)
            itemGroupId = 2;

        $("#main-grid").first().prepend($("#tab-container"));
        $("#main-grid").first().prepend($("#top-section"));

        addButton = appendButtonToGrid({style: "text", onClick: addData});
        appendUndoSaveButtonsToGrid();

        appendMaterialTagTabs({ id: "material-tabs", containerId: "tab-container", onSelectionChanged: materialTabSelectionChanged });

        addTabList("top-section", "groups-tab", ["Hạt rang", "Cafe"], itemGroupId - 2, tabClicked);
    });

    function tabClicked(tabIndex) {
        itemGroupId = tabIndex + 2;
        
        console.log("tabClicked addButton", addButton);
        addButton.option("text", isProduct() ? "Tạo từ công thức" : "Thêm");

        $("#material-tabs").dxTabs("getDataSource").reload();
        $("#tab-container").css("display", itemGroupId == 3 ? "block" : "none");

        reloadData();
    }

    function materialTabSelectionChanged(e) {
        // console.log("selectedMaterialIds", $("#material-tabs").dxTabs("instance").option("selectedItemKeys"));
        selectedMaterialIds = $("#material-tabs").dxTabs("instance").option("selectedItemKeys").join(',');
        console.log("selectedMaterialIds", selectedMaterialIds);
        reloadData();
    }

    function addData() {
        if (isProduct()) {
            location.href = "/item/quicknew";
        } else {
            $(`#main-grid`).dxDataGrid("addRow");
        }
    }

    function isProduct() {
        return itemGroupId == 3;
    }

    function onInitNewRow(e) {
        e.data.Id = 0;
        e.data.Group = itemGroupId;
        e.data.Unit = 1;
        e.data.UseLot = (itemGroupId == 2);
        e.data.AllowSale = (itemGroupId == 3);
        e.data.Inactive = false;
    }
</script>