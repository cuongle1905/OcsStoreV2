@page "/inventory"
@using OcsStore.Models
@model OcsStore.Pages.InventoriesModel
@{
}

<div id="top-section" class="pb-3"></div>

@(
Html.DevExtreme().DataGrid<InventoryDetailView>()
    .ID("main-grid")
    .DataSource(d => d.Mvc().Controller("Stock").LoadAction("GetInventoryDetails").LoadMethod("POST").Key("Id").LoadParams(new { ItemGroupId = new JS("function() { return itemGroupId; }") }))
    .RemoteOperations(false)
    .ShowBorders(true)
    .ShowRowLines(true)
    .WordWrapEnabled(true)
    .Sorting(s => s.Mode(GridSortingMode.None))
    .OnContentReady("onGridContentReadyExpandFirstGroup")
    .Columns(columns =>
    {
        columns.AddFor(m => m.Date).Caption("Ngày").Width(80).Alignment(HorizontalAlignment.Center).Format("dd/MM/yyyy")
            .GroupIndex(0).SortOrder(SortOrder.Desc).AutoExpandGroup(false).GroupCellTemplate(new JS("groupCellTemplateTextOnly"));
        columns.AddFor(m => m.Time).Caption("Giờ").Width(50).Alignment(HorizontalAlignment.Center);
        columns.AddFor(m => m.ItemName).Caption("Hàng hóa").Width(120).Alignment(HorizontalAlignment.Left).CellTemplate(new JS("itemCellTemplate"));
        columns.AddFor(m => m.Soh).Caption("Số lượng").Width(60).Alignment(HorizontalAlignment.Right).Format("#,##0.0");
        columns.AddFor(m => m.Ave).Caption("Giá TB").Width(60).Alignment(HorizontalAlignment.Right).Format("#,##0");
        columns.Add().Name("Action").Width(30).Alignment(HorizontalAlignment.Center).Fixed(true).FixedPosition(HorizontalEdge.Right).CellTemplate(new JS("deleteActionCellTemplate"));
    })
    .OnCellPrepared("onCellPreparedGroupFixedRightColumn")
    .Editing(e => e.AllowUpdating(false))
    .Paging(p => p.Enabled(false))
)
<script>
    pageTitle = "KIỂM KÊ";
    deleteUrl = '@Url.Action("DeleteInventory", "Stock")';
    deleteRowKeyFields = ["Inventory"];
    $(function () {
        appendTopAddButtonToGrid({onClick: function() {
            location.href = `inventory/new?sourceurl=inventory&&itemGroup=${itemGroupId}`;
        }});
        $("#main-grid").first().prepend($("#top-section"));
        addTabList("top-section", "groups-tab", ["Nhân xanh", "Hạt rang", "Cafe"], itemGroupId - 1, tabClicked);
    });

    function tabClicked(tabIndex) {
        console.log("tabClicked", tabIndex);
        itemGroupId = tabIndex + 1;
        $("#main-grid").dxDataGrid("instance").refresh();
    }

    function itemCellTemplate(container, options) {
        container.html(dotSymbolHtml(cssColorForItemType(options.data.ItemGroup)) + options.text);
    }

</script>