@page "/stockcard"
@using OcsStore.Models
@model OcsStore.Pages.StockCardModel
@{
}
<style>
</style>

<div id="top-section" class="pb-2"></div>

@(
Html.DevExtreme().DataGrid<StockCardView>()
    .ID("main-grid")
    .DataSource(d => d.Mvc().Controller("Stock").LoadAction("GetStockCard").LoadMethod("POST").Key("Id").LoadParams(new { Date = new JS("function() { return selectedDate.toISOString(); }"), ItemId = Model.ItemId }))
    .RemoteOperations(false)
    .ShowBorders(true)
    .ShowRowLines(true)
    .WordWrapEnabled(true)
    .Sorting(s => s.Mode(GridSortingMode.None))
    .OnContentReady("defaultOnGridContentReady")
    .Columns(columns =>
    {
        columns.AddFor(m => m.Date).Caption("Ngày").Width(80).Alignment(HorizontalAlignment.Center).Format("dd/MM/yyyy").GroupIndex(0);
        columns.AddFor(m => m.Time).Caption("Giờ").Width(42).Alignment(HorizontalAlignment.Center).CellTemplate(new JS("editTimeCellTemplate"));
        columns.AddFor(m => m.Description).Caption("Mô tả").Width(64).Alignment(HorizontalAlignment.Left);
        columns.AddFor(m => m.Quantity).Caption("Số lượng").Width(60).Alignment(HorizontalAlignment.Right).Format("#,##0.0").CellTemplate(new JS("stockCellTemplate"));
        columns.AddFor(m => m.Price).Caption("Giá").Width(55).Alignment(HorizontalAlignment.Right).Format("#,##0").CssClass("gray");

        columns.AddFor(m => m.Soh).Caption("SL tồn").Width(50).Alignment(HorizontalAlignment.Right).Format("#,##0.0").CellTemplate(new JS("negativeAlertCellTemplate"));
        columns.AddFor(m => m.Ave).Caption("Giá TB").Width(55).Alignment(HorizontalAlignment.Right).Format("#,##0");
        columns.AddFor(m => m.ValueK).Caption("Giá trị\n(x 1000đ)").Width(60).HeaderCellTemplate(new JS("subLineHeaderCellTemplate")).Alignment(HorizontalAlignment.Right).Format("#,##0");
    })
    .Editing(e => e.AllowUpdating(false))
    .Paging(p => p.Enabled(false))
)

<script>
    pageTitle = "Thẻ kho @(Model.Item.Name)";
    goBackUrl = `/stock?itemGroup=@(Model.Item.Group)&date=${selectedDate.getTime()}`;
    const itemId = @(Model.ItemId);
    editDateTimeUrl = '@Url.Action("EditDateTime", "Stock")';

    $(function () {
        console.log("selectedDate", selectedDate);

        const topSection = $("#top-section");
        $("#main-grid").first().prepend(topSection);
        const dateContainer = appendFlexContainer({ container: topSection });
        const dateBox = appendDateField({ container: dateContainer, value: selectedDate, onValueChanged: dateChanged });

        appendButtonToGrid({ id: "calculate-soh", level: 2, text: "Tính toán lại tồn kho", width: "50%", icon: "bi bi-calculator", onClick: calculateSoh });
    });

    function dateChanged(e) {
        selectedDate = e.value;
        $("#main-grid").dxDataGrid("instance").refresh();
    }

    function calculateSoh() {
        $.ajax({
            url: '@Url.Action("CalculateItemSoh", "Stock")',
            method: "POST",
            data: { itemId: itemId },
            success: function (result) {
                DevExpress.ui.dialog.alert("Đã tính toán lại tồn kho.", "Thông báo").then(function(dialogResult) {
                    reloadData();
                });
            },
            error: function (xhr, status, error) {
                console.log("xhr", xhr, "status", status, "error", error);
                DevExpress.ui.dialog.alert("Có lỗi xảy ra. Vui lòng thử lại sau.", "Cảnh báo");
            }
        });
    }

    function stockCellTemplate(container, options) {
        let quantityOut = (options.data.Quantity < 0);
        let cssClass = (quantityOut ? "red" : "green");
        let text = options.text;
        if (options.column.dataField == "Quantity") {
            if (options.data.Quantity > 0)
                text = "+" + options.text;
        }

        let html = `<div class='${cssClass}'>${text}</div>`
        container.html(html);
    }

    function negativeAlertCellTemplate(container, options) {
        console.log("redNegativeCellTemplate", options, options.value);
        if (options.value < 0) {
            let html = `<div class='d-flex align-items-center red'><div style='color: var(--red)'><i class="bi bi-exclamation-circle"></i></div><div style='margin-left:auto'>${options.text}</div></div>`;
            container.html(html);
        } else
            container.html(options.text);
    }
</script>