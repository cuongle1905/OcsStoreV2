@page "/stock"
@using OcsStore.Models
@model OcsStore.Pages.StockModel
@{
}
<style>
    a.stock-link {
        padding-left: 0.1rem;
        padding-right: 0.2rem;
    }
    a.icon-link:hover {
        text-decoration: none;
    }
</style>

<div id="top-section" class="pb-3"></div>

<div id="tab-container" class="pb-3"></div>

@(
Html.DevExtreme().DataGrid<StockView>()
    .ID("main-grid")
    .DataSource(d => d.Mvc().Controller("Stock").LoadAction("GetStocks").LoadMethod("POST").LoadParams(new { ItemGroupId = new JS("function() { return itemGroupId; }"), materialIds = new JS("function() { return selectedMaterialIds; }") }))
    .RemoteOperations(false)
    .ShowBorders(true)
    .ShowRowLines(true)
    .WordWrapEnabled(true)
    .Sorting(s => s.Mode(GridSortingMode.None))
    .Paging(p => p.PageSize(12).Enabled(true))
    @* .Pager(p => p.Visible(false)) *@
    .OnContentReady("defaultOnGridContentReady")
    .Columns(columns =>
    {
        columns.AddFor(m => m.ItemName).Caption("Hàng hóa").Width(130).Alignment(HorizontalAlignment.Left).Fixed(true).FixedPosition(HorizontalEdge.Left).CellTemplate(new JS("stockCellTemplate"));
        columns.AddFor(m => m.Soh).Caption("Số lượng\n(Kg)").Width(80).HeaderCellTemplate(new JS("subLineHeaderCellTemplate")).Alignment(HorizontalAlignment.Right).Format("#,##0.0").CellTemplate(new JS("stockCellTemplate"));
        columns.AddFor(m => m.Ave).Caption("Giá TB\n(đồng)").Width(70).HeaderCellTemplate(new JS("subLineHeaderCellTemplate")).Format("#,##0").CellTemplate(new JS("stockCellTemplate"));
        columns.AddFor(m => m.Value).Caption("Giá trị\n(x 1000đ)").Width(80).HeaderCellTemplate(new JS("subLineHeaderCellTemplate")).Format("#,##0").CellTemplate(new JS("stockCellTemplate"));
        
        columns.AddFor(m => m.Date).Caption("Ngày").Width(90).Alignment(HorizontalAlignment.Center).Format("dd/MM/yyyy").CellTemplate(new JS("stockCellTemplate"));
        columns.AddFor(m => m.Time).Caption("Giờ").Width(50).Alignment(HorizontalAlignment.Center).CellTemplate(new JS("stockCellTemplate"));
        @* columns.Add().Name("Action").Width(36).Alignment(HorizontalAlignment.Center).Fixed(true).FixedPosition(HorizontalEdge.Right).CellTemplate(new JS("addDataCellTemplate")); *@
    })
    .Editing(e => e.AllowUpdating(false))
    .Paging(p => p.Enabled(true).PageSize(100))
    .Summary(s => s
        .CalculateCustomSummary("calculateCustomSummary")
        .TotalItems(items =>
        {
            items.Add().ShowInColumn("Value")
                .Name("ValueSummary")
                .SummaryType(SummaryType.Custom)
                .DisplayFormat("{0}")
                .ValueFormat("#,##0");
        })
    )
)

@(Html.DevExtreme().Popup()
    .ID("actions-popup")
    .Width(100)
    .Height(40)
    .Container("#main-grid")
    .Visible(false)
    .ShowTitle(false)
    .ShowCloseButton(false)
    .HideOnOutsideClick(true)
    .ContentTemplate(@<text>
        <div>Hello</div>
    </text>)
)

<script>
    pageTitle = "Tồn kho";
    var selectedMaterialIds = [];

    $(function () {
        $("#main-grid").first().prepend($("#tab-container"));
        $("#main-grid").first().prepend($("#top-section"));

        appendMaterialTagTabs({ id: "material-tabs", containerId: "tab-container", onSelectionChanged: materialTabSelectionChanged });

        addTabList("top-section", "groups-tab", ["Nhân xanh", "Hạt rang", "Cafe"], itemGroupId - 1, tabClicked);

        appendButtonToGrid({ id: "calculate-soh", level: 2, text: "Tính toán lại tồn kho", width: "50%", icon: "bi bi-calculator", onClick: calculateSoh });
    });

    function expandCollapseData() {
        let grid = $("#main-grid").dxDataGrid("instance");
        grid.columnOption("Date", "visible", isDataExpanded);
        grid.columnOption("Time", "visible", isDataExpanded);
    }

    function tabClicked(tabIndex) {
        console.log("tabClicked", tabIndex);
        itemGroupId = tabIndex + 1;
        
        $("#material-tabs").dxTabs("getDataSource").reload();
        $("#tab-container").css("display", itemGroupId == 3 ? "block" : "none");

        $("#main-grid").dxDataGrid("instance").refresh();
    }

    function materialTabSelectionChanged(e) {
        console.log("selectedMaterialIds", $("#material-tabs").dxTabs("instance").option("selectedItemKeys"));
        selectedMaterialIds = $("#material-tabs").dxTabs("instance").option("selectedItemKeys");
        console.log("selectedMaterialIds", selectedMaterialIds);
        reloadData();
    }

    function stockCellTemplate(container, options) {
        lotTableCellTemplate(container, options);
        
        if (options.column.dataField == "Soh") {
            if (options.data.SohWarning) {
                let html = `<div class='d-flex align-items-center'><div style='color: var(--red)'><i class="bi bi-exclamation-circle"></i></div><div style='margin-left:auto'>${options.text}</div></div>`;
                container.children().first().html(html);
            }
        }

        // if (options.data.Lot == null || options.data.Lot == "") {
        //     container.css("padding-top", "0.8rem");
        //     container.css("padding-bottom", "0.8rem");
        // }
    }

    function addDataCellTemplate(container, options) {
        let lot = options.data.Lot;
        if (lot == null || lot == "") {
            let itemId = options.data.Item;
            let itemType = options.data.ItemType;
            let actionCount = (options.data.AllowSale && options.data.Soh > 0 ? 2 : 1);

            let popupItems =  [ { id: 1, text: (itemType == 1 ? "Nhập kho" : options.data.ProcessingName), icon: "add" } ];
            if (options.data.AllowSale && options.data.Soh > 0) {
                popupItems.push({ id: 2, text: "Bán hàng", icon: "bi bi-box-arrow-right" });
            }
            popupItems.push({ id: 3, text: "Sửa thông tin", icon: "edit" });

            let firstAction = (itemType == 1 ? 1 : 2);
           
            // $("<div>").dxDropDownButton({
            //     text: "",
            //     icon: detailArrowIcon,
            //     stylingMode: "text",
            //     showArrowIcon: false,
            //     items: popupItems,
            //     elementAttr: { class: "no-border-button cell-link-button" },
            //     dropDownOptions: {
            //         width: 140,
            //         height: "auto",
            //         shading: false
            //     },
            //     onItemClick: function (e) {
            //         goToAction(e.itemData.id >= 2 ? e.itemData.id + 1 : firstAction, itemId);
            //     }
            // }).appendTo(container);
            // container.css({"padding": "1px" });

            $("<div>").dxButton({
                text: "",
                icon: detailArrowIcon,
                stylingMode: "text",
                elementAttr: { class: "no-border-button cell-link-button" },
                onClick: function (e) {
                    goToAction(firstAction, itemId);
                }
            }).appendTo(container);
            container.css({"padding": "1px" });

        }
    }

    function goToAction(action, itemId) {
        let link = (action == 1 ? "/receiving/new" : (action == 2 ? "/processing/new" : (action == 3 ? "/bill/new" : "/item"))) + "?item=" + itemId + "&itemGroup=" + itemGroupId + "&sourceurl=stock";
        location.href = link;
    }

    function addNewItem() {
        goToAction(4, 0);
    }

    function calculateCustomSummary(options) {
        // console.log(options);
        if (options.name === "ValueSummary") {
            if (options.summaryProcess === "start") {
                options.totalValue = 0;
            }
            if (options.summaryProcess === "calculate") {
                if (options.value.Lot == "") {
                    options.totalValue += options.value.Value;
                }
            }
            if (options.summaryProcess === "finalize") {
                //
            }
        }
    }

    function calculateSoh() {
        $.ajax({
            url: '@Url.Action("CalculateItemGroupSoh", "Stock")',
            method: "POST",
            data: { itemGroupId: itemGroupId },
            success: function (result) {
                DevExpress.ui.dialog.alert("Đã tính toán lại tồn kho.", "Thông báo").then(function(dialogResult) {
                    reloadData();
                });
            },
            error: function (xhr, status, error) {
                console.log("xhr", xhr, "status", status, "error", error);
                DevExpress.ui.dialog.alert("Có lỗi xảy ra. Vui lòng thử lại sau.", "Cảnh báo");
            }
        });
    }
</script>