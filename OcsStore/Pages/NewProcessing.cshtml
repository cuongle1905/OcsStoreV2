@page "/processing/new"
@using OcsStore.Models
@model OcsStore.Pages.NewProcessingModel
@{
    string outputItemCssColor = (Model.Item.ItemType == Item.Product ? "blue" : "brown");
}
<style>
    #select-customer {
        margin-top: 1rem;
        margin-bottom: 1rem;
    }
</style>

<div id="top-section" class="ms-auto me-auto" style="width: 24rem;">
    <div class="d-flex">
        <div class="data-field">
            <div class="field-title">Ngày:</div>
            @(Html.DevExtreme().DateBox()
                .ID("dateBox")
                .Width("12rem")
                .Height("2rem")
                .InputAttr("aria-label", "Date")
                .Type(DateBoxType.Date)
                .Value(DateTime.Today)
                .DisplayFormat("dd/MM/yyyy")
                .DropDownOptions(o => o.Position(p => p.Of("#dateBox").At(HorizontalAlignment.Left, VerticalAlignment.Bottom).My(HorizontalAlignment.Left, VerticalAlignment.Top).Offset(0, 2)))
            )
        </div>
        <div class="data-field" style="margin-left: 2rem;">
            <div class="field-title">Giờ:</div>
            @(Html.DevExtreme().DateBox()
                .ID("timeBox")
                .Width("10rem")
                .Height("2rem")
                .Type(DateBoxType.Time)
                .Value(DateTime.Now)
                .DisplayFormat("HH:mm")
            )
        </div>
    </div>

    <div class="d-flex mb-2">
        <div class="data-field">
            <div class="field-title">@(Model.Item.GroupName):</div>
            @(
            Html.DevExtreme().SelectBox()
                .ID("itemSelectBox")
                .DataSource(d => d.Mvc().Controller("Item").LoadAction("GetItemViews").LoadMethod("POST").LoadParams(new { GroupId = Model.Item.Group }).Key("Id"))
                .Width("12rem")
                .Height("2rem")
                .DisplayExpr("Name")
                .ValueExpr("Id")
                .OnValueChanged("itemChanged")
                .ItemTemplate(@<text> <div><span class="@(outputItemCssColor) me-2 dot-symbol">●</span><%- Name %></div> </text>)
                .FieldTemplate(@<text>
                    <div class="d-flex ps-1 pt-1 pe-2">
                        <div class="@(outputItemCssColor) ms-2 dot-symbol">●</div>

                        @(Html.DevExtreme().TextBox()
                            .Height("1.3rem")
                            .Value(new JS("typeof Name !== 'undefined' ? Name : ''"))
                            .ReadOnly(true)
                            .ElementAttr("class", "inner-text-field")
                        )

                        @* <div class="ms-auto" style="margin-top: 1px;"><i class="dx-icon-chevrondown" style="font-size: 0.8rem;"></i></div> *@
                    </div>
                 </text>)
                .Value(Model.Item.Id)
                .DropDownOptions(o => o.Position(p => p.Of("#itemSelectBox").At(HorizontalAlignment.Left, VerticalAlignment.Bottom).My(HorizontalAlignment.Left, VerticalAlignment.Top).Offset(0, 2)))
            )
            <span id="processing-desc"></span>
        </div>
        <div class="data-field" style="margin-left: 2rem;">
            <div class="field-title">Số lượng:</div>
            <div class="custom-textbox-wrapper">
                @(Html.DevExtreme().NumberBox()
                    .ID("item-quantity")
                    .Width("10rem")
                    .Height("2rem")
                    .Format("#,##0.00")
                    .Min(0)
                    .Max(10000)
                    .ShowSpinButtons(false)
                    .ElementAttr("class", "align-right-numberbox")
                    .InputAttr(new { @class = "has-suffix" })
                    .OnFocusIn("onNumberBoxFocusIn")
                    .OnValueChanged("itemQuantityChanged")
                )
                <span class="textbox-suffix">@(Model.Item.UnitName)</span>
            </div>
        </div>
    </div>
</div>
@(
Html.DevExtreme().DataGrid<ProcessingLotInputView>()
    .ID("main-grid")
    .DataSource(d => d.Mvc().Controller("Processing").LoadAction("GetNewDetails").LoadMethod("POST").LoadParams(new { ItemId = new JS("function () { return itemId; }") }).OnLoaded("gridDataLoaded"))
    .RemoteOperations(false)
    .ShowBorders(true)
    .ShowRowLines(true)
    .WordWrapEnabled(true)
    .Sorting(s => s.Mode(GridSortingMode.None))
    .Paging(p => p.PageSize(100))
    .Pager(p => p.Visible(false))
    .OnContentReady("gridContentReady")
    .Columns(columns =>
    {
        columns.AddFor(m => m.ItemName).Caption("Nguyên liệu").Width(125).Alignment(HorizontalAlignment.Left).AllowEditing(false).CellTemplate(new JS("lotTableCellTemplate"));
        columns.AddFor(m => m.Quantity).Caption("Số lượng").Width(60).Alignment(HorizontalAlignment.Right).CustomizeText("emptyZeroNumberCellText")
            .DataType(GridColumnDataType.Number) // Tells the grid to use dxNumberBox
            .Format("#,##0.00") // How the number displays outside of edit mode
            .EditorOptions(new { format = "#,##0.00", min = 0, max = 10000, step = 1, showSpinButtons = false })
            .CellTemplate(new JS("lotTableCellTemplate"));
        columns.AddFor(m => m.UnitName).Caption("").Width(40).Alignment(HorizontalAlignment.Left).AllowEditing(false).CellTemplate(new JS("lotTableCellTemplate"));
        columns.AddFor(m => m.Soh).Caption("Tồn kho").Width(60).Alignment(HorizontalAlignment.Right).CellTemplate(new JS("sohCellTemplate")).Format("#,##0.00").AllowEditing(false);
        columns.AddFor(m => m.Note).Caption("Ghi chú").Width(140).Alignment(HorizontalAlignment.Left).CellTemplate(new JS("lotTableCellTemplate"));
    })
    .Editing(e => e.AllowUpdating(true).Mode(GridEditMode.Batch).SelectTextOnEditStart(true))
    .OnEditorPreparing("onEditorPreparing")
    .RepaintChangesOnly(true)
)

<div id="sale-section" class="ms-auto me-auto mt-3 mb-3 p-3" style="border-radius: 10px; border: solid 1px #ccc; width: 26rem; background-color: white;">
    @(Html.DevExtreme().CheckBox()
        .ID("sale-check-box")
        .Value(false)
        .Text("Bán hàng:")
        .OnValueChanged("saleChecked")
    )
        
    <div class="data-field mt-2">
        <div class="field-title">Giá bán:</div>
        <div>
            @(Html.DevExtreme().NumberBox()
                .ID("sale-price")
                .Width("auto").Height("2rem")
                .Format("#,##0")
                .Min(0).Max(100000000)
                .ShowSpinButtons(false)
                .ElementAttr("class", "align-right-numberbox")
                .OnFocusIn("onNumberBoxFocusIn")
            )
        </div>
    </div>

    <ul id="customer-tab" class="nav nav-justified mt-2 mb-2" style="background-color: #f2f2f4;">
        <li class="nav-item">
            <a class="nav-link active" aria-current="page" href="#" onclick="tabClicked(0);">Khách cũ</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="#" onclick="tabClicked(1);">Khách mới</a>
        </li>
    </ul>
    
    @(Html.DevExtreme().SelectBox()
        .Width("auto").Height("2rem")
        .ID("select-customer")
        .InputAttr("aria-label", "Customer")
        .DataSource(d => d
            .Mvc().Controller("Sales")
            .LoadAction("GetCustomers").LoadMethod("POST")
            .LoadMode(DataSourceLoadMode.Raw)
            .Key("Id")
        )
        .DisplayExpr("Name")
        .ValueExpr("Id")
        .Placeholder("Chọn khách hàng cũ")
        .SearchEnabled(true)
        .DropDownOptions(options => options.Width(300))
        .OnValueChanged("customerSelectionChanged")
        .ItemTemplate(@<text>
            <div class="d-flex align-items-baseline">
                <div class="customer-name"><%- Name %></div>
                <div class="customer-phone ms-auto"><%- Phone %></div>
            </div>
        </text>)
    )
    <div class="data-field">
        <div class="field-title">Tên KH:</div>
        @(Html.DevExtreme().TextBox()
            .Width("auto").Height("2rem")
            .ID("customer-name")
            .ShowClearButton(true)
        )
    </div>
    <div class="data-field">
        <div class="field-title">Điện thoại:</div>
        @(Html.DevExtreme().TextBox()
            .Width("auto").Height("2rem")
            .ID("customer-phone")
            .ShowClearButton(true)
        )
    </div>
    <div class="data-field">
        <div class="field-title">Địa chỉ:</div>
        @(Html.DevExtreme().TextBox()
            .Width("auto").Height("2rem")
            .ID("customer-address")
            .ShowClearButton(true)
        )
    </div>
    @(Html.DevExtreme().CheckBox()
        .ID("debit-check-box")
        .Text("Ghi nợ")
    )
</div>

<div id="bottom-buttons" class="pt-3 text-center">
    @(Html.DevExtreme().Button()
        .Text("Lưu")
        .Width(160)
        .Type(ButtonType.Default)
        .StylingMode(ButtonStylingMode.Contained)
        .Icon("bi bi-download")
        .OnClick("save")
    )
</div>

<div id="hidden-section" style="visibility: hidden">

</div>

<script>
    pageTitle = "Chế biến - @(Model.Item.ProcessingName)";
    let createBill = false;

    let processingDate = new Date('@(DateTime.Today.ToString("yyyy-MM-dd"))');
    let itemId = @(Model.Item.Id);
    let itemQuantity = 0;
    let materialUseLot = false;
    let isNewCustomer = false;

    $(function () {
        addDateOverlayLabel("dateBox", dateChanged);
        $("#main-grid").first().prepend($("#top-section"));
        $("#main-grid").first().append($("#sale-section"));
        $("#main-grid").first().append($("#bottom-buttons"));
        updatecreateBill();
    });

    function gridContentReady() {
        let cells = $(".dx-header-row > td");
        cells.css("text-align", "center");
    }

    function gridDataLoaded() {
        setTimeout(() => {
            updateDetailLots();
        }, 100)
    }

    function onEditorPreparing(e) {
        if (e.parentType === "dataRow") {
            e.editorOptions.valueChangeEvent = "keyup";

            if (e.dataField === "Quantity") {
                // Save the original onValueChanged handler (prevents breaking DataGrid save logic)
                let originalOnValueChanged = e.editorOptions.onValueChanged;

                // 3. Override the event
                e.editorOptions.onValueChanged = function(args) {
                    let newValue = args.value;
                    let previousValue = args.previousValue;

                    // Trigger custom logic (e.g., calculating another column)
                    // console.log("New value: ", newValue);

                    // Update the DataGrid data using setValue
                    e.setValue(newValue); 

                    // Call the original handler to complete the standard grid operation
                    if (originalOnValueChanged) {
                        originalOnValueChanged(args);
                    }

                    console.log("onEditorPreparing", e);

                    let materialId = e.row.data.Item;
                    let lot = e.row.data.Lot;

                    console.log("materialId", materialId, "lot", lot);

                    let grid = $("#main-grid").dxDataGrid("instance");
                    let rows = grid.getVisibleRows();
                    let materialQuantity = 0;
                    for (var i = 0; i < rows.length; i++) {
                        const row = rows[i];
                        if (row.rowType == "data" && row.data.Item == materialId) {
                            const isCurrentRow = (i == e.row.rowIndex);
                            const isAboveRow = (i < e.row.rowIndex);

                            if (row.data.Lot == null || row.data.Lot == "") {
                                if (isCurrentRow) {
                                    materialQuantity = newValue;
                                } else {
                                    materialQuantity = grid.cellValue(i, "Quantity");
                                }
                            } else {
                                let lotQuantity = (isCurrentRow ? newValue : (isAboveRow ? grid.cellValue(i, "Quantity") : Math.min(row.data.Soh, materialQuantity)));
                                if (!isCurrentRow) {
                                    grid.cellValue(i, "Quantity", lotQuantity);
                                    console.log("quantity cell changed, set value", i, lotQuantity);
                                }
                                materialQuantity -= lotQuantity;
                            }
                            console.log("quantity cell changed", i, materialQuantity);
                        }
                    }
                };
            }
        }
    }

    function dateChanged(e) {
        processingDate = e.value;
        updateDetailLots();
    }

    function itemChanged(e) {
        itemId = e.value;

        var outputItem = e.component.option("selectedItem");
        // console.log(outputItem);
        $("#processing-desc").text(outputItem.ProcessingDesc ?? "");

        $("#main-grid").dxDataGrid("instance").refresh();
    }

    function itemQuantityChanged(e) {
        itemQuantity = $("#item-quantity").dxNumberBox("instance").option("value");
        let grid = $("#main-grid").dxDataGrid("instance");
        let rows = grid.getVisibleRows();
        let materialQuantity = 0;
        for (var i = 0; i < rows.length; i++) {
            const row = rows[i];
            console.log(row.data); // The raw data object for this row
            if (row.rowType == "data") {
                if (row.data.Lot == null || row.data.Lot == "") {
                    materialQuantity = Math.round(itemQuantity * row.data.MaterialQuantity * 100) / 100;
                    grid.cellValue(i, "Quantity", materialQuantity);
                } else {
                    let lotQuantity = Math.min(row.data.Soh, materialQuantity);
                    grid.cellValue(i, "Quantity", lotQuantity);
                    materialQuantity -= lotQuantity;
                }
            }
        }
    }

    function updateDetailLots() {
        let grid = $("#main-grid").dxDataGrid("instance");
        let rows = grid.getVisibleRows();
        materialUseLot = rows.find(i => i.rowType == "data" && i.data.UseLot) != undefined;
        grid.columnOption("Lot", "visible", materialUseLot);
    }

    function sohCellTemplate(container, options) {
        lotTableCellTemplate(container, options);
        container.html(`<a class='text-link' href='#' onclick='sohClicked(${options.rowIndex});'><span>${options.text}</span></a>`);
    }

    function itemCellTemplate(container, options) {
        let cssColor = cssColorForItemType(options.data.ItemType);
        displayCell(container, options, "●", cssColor);
    }

    function sohClicked(rowIndex) {
        let grid = $("#main-grid").dxDataGrid("instance");
        let soh = grid.cellValue(rowIndex, "Soh");
        grid.cellValue(rowIndex, "Quantity", soh);
    }

    function saleChecked(e) {
        createBill = e.value;
        updatecreateBill();
    }

    function updatecreateBill() {
        if (createBill) {
            $('#sale-section').children().eq(3).before($("#customer-tab"));
            $('#sale-section').append($("#debit-check-box"));
        } else {
            $("#hidden-section").append($("#customer-tab"));
            $('#hidden-section').append($("#debit-check-box"));
        }
        showHideCustomerSelector();
        $("#sale-section > .data-field").css("display", createBill ? "block" : "none");
    }

    function showHideCustomerSelector() {
        if (createBill && !isNewCustomer) {
            $('#sale-section').children().eq(4).before($("#select-customer"));
        } else {
            $("#hidden-section").append($("#select-customer"));
        }
    }

    function tabClicked(tabIndex) {
        $(`#customer-tab > :nth-child(${isNewCustomer ? 2 : 1}) .nav-link`).removeClass("active");
        isNewCustomer = (tabIndex == 1);
        updateSelectedTab();
    }

    function updateSelectedTab() {
        $(`#customer-tab > :nth-child(${isNewCustomer ? 2 : 1}) .nav-link`).addClass("active");
        showHideCustomerSelector();
    }
    
    function customerSelectionChanged(e) {
        var customer = e.component.option("selectedItem");
        $("#customer-name").dxTextBox("instance").option("value", customer != null ? customer.Name : "");
        $("#customer-phone").dxTextBox("instance").option("value", customer != null ? customer.Phone : "");
        $("#customer-address").dxTextBox("instance").option("value", customer != null ? customer.Address : "");
    }

    function save() {
        let quantity = $("#item-quantity").dxNumberBox("instance").option("value");
        if (quantity == null || quantity <= 0) {
            DevExpress.ui.dialog.alert("Hãy nhập vào Số lượng.", "Cảnh báo");
            return;
        }

        let grid = $("#main-grid").dxDataGrid("instance");
        // grid.saveEditData();

        var details = []
        let rows = grid.getVisibleRows();
        let itemName = "";
        let materialQuantity = 0;
        for (var i = 0; i < rows.length; i++) {
            const row = rows[i];
            if (row.rowType == "data" && row.data.Quantity > 0) {
                if (row.data.Quantity > row.data.Soh) {
                    DevExpress.ui.dialog.alert(`[${row.data.ItemName + (row.data.Lot.length > 0 ? ' ' + row.data.Lot : '')}] Số lượng ${row.data.Quantity} vượt quá tồn kho ${row.data.Soh}.`, "Cảnh báo");
                    return;
                }

                if (row.data.Lot == null || row.data.Lot == "") {
                    if (i > 0 && materialQuantity > 0) {
                        DevExpress.ui.dialog.alert(`[${itemName}] Tổng số lượng các Lô không khớp với Số lượng nguyên liệu.`, "Cảnh báo");
                        return;
                    }
                    materialQuantity = row.data.Quantity;
                    itemName = row.data.ItemName;
                } else {
                    materialQuantity -= row.data.Quantity;
                }

                if (i == rows.length - 1 && row.data.Lot != null && row.data.Lot != "" && materialQuantity > 0) {
                    DevExpress.ui.dialog.alert(`[${itemName}] Tổng số lượng các Lô không khớp với Số lượng nguyên liệu.`, "Cảnh báo");
                    return;
                }
                details.push(row.data);
            }
        }
        console.log(details);

        if (details.length == 0) {
            DevExpress.ui.dialog.alert("Hãy nhập vào số lượng nguyên liệu.", "Cảnh báo");
            return;
        }

        let salePrice = 0.0;
        let customer = {};
        let debit = false;
        if (createBill) {
            salePrice = $("#sale-price").dxNumberBox("instance").option("value");
            if (salePrice == null || salePrice <= 0) {
                DevExpress.ui.dialog.alert("Hãy nhập vào Giá bán.", "Cảnh báo");
                return;
            }

            if (isNewCustomer) {
                customer.Id = 0;
            } else {
                customer.Id = $("#select-customer").dxSelectBox("instance").option("value");
                if (customer.Id == null)    {
                    DevExpress.ui.dialog.alert("Hãy nhập chọn khách hàng cũ.", "Cảnh báo");
                    return;
                }
            }

            customer.Name = $("#customer-name").dxTextBox("instance").option("value");
            customer.Phone = $("#customer-phone").dxTextBox("instance").option("value");
            customer.Address = $("#customer-address").dxTextBox("instance").option("value");

            if (customer.Name == null || customer.Name.length == 0) {
                DevExpress.ui.dialog.alert("Hãy nhập vào Tên khách hàng.", "Cảnh báo");
                return;
            }

            debit = $("#debit-check-box").dxCheckBox("instance").option("value");
        }

        DevExpress.ui.dialog.confirm("<i>Bạn có chắc chắn lưu dữ liệu?</i>", "Xác nhận").then(function(dialogResult) {
            if (dialogResult) {
                let processing = {};
                processing.Date = $("#dateBox").dxDateBox("instance").option("value").toISOString();
                processing.Time = $("#timeBox").dxDateBox("instance").option("text");
                processing.Item = itemId;
                processing.Quantity = quantity;

                $.ajax({
                    url: '@Url.Action("Save", "Processing")',
                    method: "POST",
                    data: { processing: processing, details: details, createBill: createBill, salePrice: salePrice, customer: customer, debit: debit },
                    success: function (result) {
                        DevExpress.ui.dialog.alert("Đã lưu dữ liệu.", "Thông báo").then(function(dialogResult) {
                            location.href = goBackUrl;
                        });
                    },
                    error: function (xhr, status, error) {
                        console.log("xhr", xhr, "status", status, "error", error);
                        DevExpress.ui.dialog.alert("Có lỗi xảy ra. Vui lòng thử lại sau.", "Cảnh báo");
                    }
                });
            }
        });
    }
</script>