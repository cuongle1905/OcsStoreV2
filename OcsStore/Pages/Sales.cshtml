@page "/sales"
@using OcsStore.Models
@model OcsStore.Pages.SalesModel
@{
}
<style>
</style>
<div id="top-section" class="ms-auto me-auto pt-3" style="width: 100%;">
</div>
@(
Html.DevExtreme().DataGrid<BillView>()
    .ID("main-grid")
    .DataSource(d => d.Mvc().Controller("Sales").LoadAction("GetBills").LoadMethod("POST").Key("Id"))
    .RemoteOperations(false)
    .ShowBorders(true)
    .ShowRowLines(true)
    .WordWrapEnabled(true)
    .Sorting(s => s.Mode(GridSortingMode.None))
    .Paging(p => p.PageSize(100))
    .Pager(p => p.Visible(false))
    .OnContentReady("defaultOnGridContentReady")
    .Columns(columns =>
    {
        columns.AddFor(m => m.Date).Caption("Ngày").Width(90).Alignment(HorizontalAlignment.Center).Format("dd/MM/yyyy").GroupIndex(0);
        columns.AddFor(m => m.Id).Caption("#").Width(40).Alignment(HorizontalAlignment.Center);
        columns.AddFor(m => m.Time).Caption("Giờ").Width(50).Alignment(HorizontalAlignment.Center);
        columns.AddFor(m => m.CustomerName).Caption("Khách hàng").Width(100).Alignment(HorizontalAlignment.Left);
        columns.AddFor(m => m.CustomerPhone).Caption("Điện thoại").Width(100).Alignment(HorizontalAlignment.Left);
        columns.AddFor(m => m.Note).Caption("Ghi chú").Width(140).Alignment(HorizontalAlignment.Left);
        columns.AddFor(m => m.Paid).Caption("Đã thanh toán").Width(60).Alignment(HorizontalAlignment.Center).Fixed(true).FixedPosition(HorizontalEdge.Right);
        columns.AddFor(m => m.TotalValue).Caption("Tổng tiền").Width(90).Alignment(HorizontalAlignment.Right).Fixed(true).FixedPosition(HorizontalEdge.Right).Format("#,##0");
    })
    .Editing(e => e.AllowUpdating(false))
    .Paging(p => p.Enabled(true).PageSize(100))
    .Summary(s => s
        .TotalItems(items =>
        {
            items.AddFor(m => m.TotalValue)
                 .SummaryType(SummaryType.Sum)
                 .DisplayFormat("{0}")
                 .ValueFormat("#,##0");
        })
    )
)

<script>
    pageTitle = "Bán hàng"

    $(function () {
        appendTopAddButtonToGrid({ onClick: function() {
            location.href = "sales/new";
        }});
    });
</script>