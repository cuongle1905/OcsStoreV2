@page "/sales"
@using OcsStore.Models
@model OcsStore.Pages.SalesModel
@{
}
<style>
    .dx-datagrid-rowsview .dx-data-row .dx-cell-modified.dx-cell-modified::after, .dx-datagrid-rowsview .dx-data-row .dx-cell-modified.dx-datagrid-invalid::after {
        border-color: transparent;
    }
</style>
<script>
    dateRangeControl.fromDate = dateRangeControl.toDate.firstDateOfMonth();
</script>
<div id="top-section" class="ms-auto me-auto" style="width: 100%;">
</div>
@(
Html.DevExtreme().DataGrid<BillView>()
    .ID("main-grid")
    .DataSource(d => d.Mvc().Controller("Sales").LoadAction("GetBills").LoadMethod("POST").LoadParams(new { CustomerId = new JS("function() { return customerId; }"), FromDate = new JS("function() { return dateRangeControl.fromDate.toISOString(); }"), ToDate = new JS("function() { return dateRangeControl.toDate.toISOString(); }") }).Key("Id"))
    .RemoteOperations(false)
    .ShowBorders(true)
    .ShowRowLines(true)
    .WordWrapEnabled(true)
    .Sorting(s => s.Mode(GridSortingMode.None))
    .OnContentReady("defaultOnGridContentReady")
    .OnCellClick("onCellClick")
    .Columns(columns =>
    {
        columns.AddFor(m => m.Date).Caption("Ngày").Width(90).Alignment(HorizontalAlignment.Center).Format("dd/MM/yyyy").GroupIndex(0).SortIndex(0).SortOrder(SortOrder.Desc).AllowEditing(false);
        columns.AddFor(m => m.Id).Caption("#").Width(30).Alignment(HorizontalAlignment.Center).CellTemplate(new JS("linkCellTemplate")).AllowEditing(false);
        columns.AddFor(m => m.Time).Caption("Giờ").Width(45).Alignment(HorizontalAlignment.Center).CellTemplate(new JS("linkCellTemplate")).AllowEditing(false);
        columns.AddFor(m => m.CustomerName).Caption("Nội dung").Width(150).Alignment(HorizontalAlignment.Left).CellTemplate(new JS("customerCellTemplate")).AllowEditing(false);
        columns.AddFor(m => m.Paid).Caption("Thanh toán").Width(42).Alignment(HorizontalAlignment.Center).AllowEditing(false).AllowEditing(false);
        columns.AddFor(m => m.VatPercent).Caption("VAT").Width(34).Alignment(HorizontalAlignment.Right).CellTemplate(new JS("percentCellTemplate"));
        columns.AddFor(m => m.TotalValue).Caption("Tổng tiền").Width(90).Alignment(HorizontalAlignment.Right).Format("#,##0").AllowEditing(false);
    })
    .Editing(e => e.AllowUpdating(true).Mode(GridEditMode.Batch).SelectTextOnEditStart(true))
    .OnEditorPreparing("onEditorPreparing")
    .Paging(p => p.Enabled(true).PageSize(15))
    .Pager(p => p.ShowPageSizeSelector(true).AllowedPageSizes([15, 30, 50]))
    .Summary(s => s
        .TotalItems(items =>
        {
            items.AddFor(m => m.TotalValue)
                 .SummaryType(SummaryType.Sum)
                 .DisplayFormat("{0}")
                 .ValueFormat("#,##0");
        })
    )
    .RepaintChangesOnly(false)
)

<script>
    pageTitle = "Bán hàng"
    cellLinkUrl = 'bill?sourceUrl=sales';
    var customers = @Html.Raw(Json.Serialize(Model.Customers));
    var mainGrid;
    var customerId = 0;

    $(function () {
        mainGrid = $("#main-grid").dxDataGrid("instance");

        appendTopAddButtonToGrid({ onClick: function() {
            location.href = cellLinkUrl;
        }});

        const topSection = $("#top-section");
        $("#main-grid").first().prepend(topSection);
        
        const flexContainer = appendFlexContainer({ container: topSection, gap: 2 });
        appendSelectField({ id: "customer-select-box", container: flexContainer, width: "10.4rem", title: "Khách hàng", dataSource: customers, onValueChanged: customerChanged });

        appendDateRangeControl({ container: flexContainer, gap: 2, onValueChanged: onDateRangeChanged });
    });

    function customerChanged(e) {
        customerId = e.value;
        mainGrid.refresh();
    }

    function onDateRangeChanged() {
        mainGrid.refresh();
    }

    function customerCellTemplate(container, options) {
        options.text += `<div class="italic" style="font-size:0.9rem;">${options.data.Desc}</div>`;
        linkCellTemplate(container, options);
    }

    function onEditorPreparing(e) {
        if (e.parentType === "dataRow") {
            // e.editorOptions.valueChangeEvent = "keyup";

            if (e.dataField === "VatPercent") {
                // Save the original onValueChanged handler (prevents breaking DataGrid save logic)
                let originalOnValueChanged = e.editorOptions.onValueChanged;

                // 3. Override the event
                e.editorOptions.onClick = function(args) {
                    console.log("onEditorPreparing onClick", e, args);
                };

                e.editorOptions.onValueChanged = function(args) {
                    let newValue = args.value;
                    let previousValue = args.previousValue;
                    const rowIndex = e.row.rowIndex;

                    // Trigger custom logic (e.g., calculating another column)
                    // console.log("New value: ", newValue);

                    // Update the DataGrid data using setValue
                    e.setValue(newValue);

                    // Call the original handler to complete the standard grid operation
                    if (originalOnValueChanged) {
                        originalOnValueChanged(args);
                    }

                    console.log("onEditorPreparing", e);

                    if (newValue != previousValue) {
                        const billId = e.row.data.Id;
                        DevExpress.ui.dialog.confirm(`<i>Bạn có chắc chắn muốn thay đổi VAT thành ${newValue}% cho đơn hàng #${billId}?</i>`, "Xác nhận").then(function(dialogResult) {
                            if (dialogResult) {
                                $.ajax({
                                    url: '@Url.Action("UpdateVatPercent", "Sales")',
                                    method: "POST",
                                    data: { billId: billId, vatPercent: newValue },
                                    success: function (result) {
                                        // reloadData();
                                        mainGrid.refresh();
                                    },
                                    error: function (xhr, status, error) {
                                        console.log("xhr", xhr, "status", status, "error", error);
                                        DevExpress.ui.dialog.alert("Có lỗi xảy ra. Vui lòng thử lại sau.", "Cảnh báo");
                                    }
                                });
                            } else {
                                mainGrid.cellValue(rowIndex, "VatPercent", previousValue);
                            }
                        });
                    }
                };
            }
        }
    }

    function onCellClick(e) {
        console.log("onCellClick", e);
        if (e.rowType === "data") {
            if (e.column.dataField === "Paid") {
                const rowIndex = e.rowIndex;
                const billId = e.row.data.Id;
                const paid = !e.row.data.Paid;
                const action = (paid ? "" : " hủy");

                DevExpress.ui.dialog.confirm(`<i>Bạn có chắc chắn${action} thanh toán đơn hàng #${billId} ${e.row.data.CustomerName}?</i>`, "Xác nhận").then(function(dialogResult) {
                    if (dialogResult) {
                        $.ajax({
                            url: '@Url.Action("UpdatePaid", "Sales")',
                            method: "POST",
                            data: { Id: billId, paid: paid },
                            success: function (result) {
                                // reloadData();
                                $("#main-grid").dxDataGrid("instance").cellValue(rowIndex, "Paid", paid);
                            },
                            error: function (xhr, status, error) {
                                console.log("xhr", xhr, "status", status, "error", error);
                                DevExpress.ui.dialog.alert("Có lỗi xảy ra. Vui lòng thử lại sau.", "Cảnh báo");
                            }
                        });
                    }
                });
            }
        }
    }
</script>