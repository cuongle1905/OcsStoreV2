@page
@using OcsStore.Models
@model OcsStore.Pages.IndexModel
@{
    IdName idName = new IdName();
}
<style>
    #content {
        margin-left: auto;
        margin-right: auto;
    }
    .note-label {
        padding-top: 0 !important;
    }
    .dx-field-item-label {
        padding-top: 0.5rem;
        padding-bottom: 0.4rem;
    }
    .flex-direction-column {
        flex-direction: column !important;
    }
</style>

<script>
    function inputValueChanged(e) {
        updateTextBoxBackground();
    }

    function inputKeyDown(e) {
        updateTextBoxBackground();
    }

    function updateTextBoxBackground() {
        let input = $("#username input")[0];
        if (input != undefined) {
            let cssObj = window.getComputedStyle(input, null);
            let bgColor = cssObj.getPropertyValue("background-color");
            $("#username").css("background-color", bgColor);

            input = $("#password input")[0];
            cssObj = window.getComputedStyle(input, null);
            bgColor = cssObj.getPropertyValue("background-color");
            $("#password").css("background-color", bgColor);
        }
    }
</script>

@if (string.IsNullOrEmpty(Session.Token(Request)))
{
    string controlHeight = "2.5rem";
    <div id="content" style="width: 21rem;">
        <div id="login-container">
            <div id="form-container" style="text-align:center;">
                <img class="login-icon" src="~/images/login-icon2.png" style="width: 5rem; margin: 1.5rem;" />
                @(Html.DevExtreme().Form<User>()
                    .ID("login-form")
                    .LabelLocation(FormLabelLocation.Top)
                    .Items(items => {
                        items.AddSimpleFor(m => m.Username)
                            .Label(l => l.Alignment(HorizontalAlignment.Left).Text("User name"))
                            .Editor(e => e
                                .TextBox()
                                .Height(controlHeight)
                                .ID("username")
                                .Placeholder("Nhập vào User name")
                                .ShowClearButton(true)
                                .HoverStateEnabled(true)
                                .OnValueChanged("inputValueChanged")
                                .OnKeyDown("inputKeyDown")
                                .Value("admin")
                            );
                        items.AddSimpleFor(m => m.Password)
                            .Label(l => l.Alignment(HorizontalAlignment.Left).Text("Mật khẩu"))
                            .Editor(e => e
                                .TextBox()
                                .ID("password")
                                .Height(controlHeight)
                                .Placeholder("Nhập vào Mật khẩu")
                                .Mode(TextBoxMode.Password)
                                .ShowClearButton(true)
                                .HoverStateEnabled(true)
                                .OnValueChanged("inputValueChanged")
                                .OnKeyDown("inputKeyDown")
                                .Value("1")
                            );
                        items.AddButton()
                            .HorizontalAlignment(HorizontalAlignment.Center)
                            .ButtonOptions(b => b.ID("login-button").Text("Đăng nhập")
                                .Width("100%")
                                .Height(controlHeight)
                                .Type(ButtonType.Default)
                                .Template(@<text>
                                    @(Html.DevExtreme().LoadIndicator()
                                    .ID("button-indicator")
                                    .IndicatorSrc("images/white-spinner.gif")
                                    .ElementAttr("style", "width: 16px; height: 16px; vertical-align: middle; margin-right: 6px")
                                    .Visible(false)
                                    )
                                    <span class="dx-button-text"><%- text %></span>
                                </text>)
                                .OnClick("login")
                            );
                        })
                    .OnContentReady(@<text>
                    function (e) { }
                    </text>)
                )
            </div>
        </div>
    </div>
}
else if (Model.IsAdmin)
{
    <div id="top-section" class="ms-auto me-auto" style="width: 100%;">
    </div>
    <div class="container">
        <div class="row">
            <div class="col-6">
                <div class="widget">
                    <div class="widget-title"><i class="bi bi-coin blue"></i>Doanh thu:</div>
                    <div id="sales-total" class="widget-value"></div>
                    <div class="d-flex widget-diff">
                        <div id="sales-total-diff" class="widget-diff-value"></div>
                        <div id="sales-total-diff-percent" class="widget-diff-percent"></div>
                    </div>
                    <div class="widget-prev d-flex">
                        <div class="widget-prev-title"></div>
                        <div id="sales-total-prev" class="widget-prev-value"></div>
                    </div>
                </div>
            </div>
            <div class="col-6">
                <div class="widget">
                    <div class="widget-title"><i class="bi bi-leaf green"></i>Sản lượng bán:</div>
                    <div id="sales-quantity" class="widget-value"></div>
                    <div class="d-flex widget-diff">
                        <div id="sales-quantity-diff" class="widget-diff-value"></div>
                        <div id="sales-quantity-diff-percent" class="widget-diff-percent"></div>
                    </div>
                    <div class="widget-prev d-flex">
                        <div class="widget-prev-title"></div>
                        <div id="sales-quantity-prev" class="widget-prev-value"></div>
                    </div>
                </div>
            </div>
            <div class="col-6">
                <div class="widget">
                    <div class="widget-title"><i class="bi bi-brightness-high brown"></i>Tỉ lệ giá vốn:</div>
                    <div id="cost-percentage" class="widget-value"></div>
                    <div class="d-flex widget-diff">
                        <div id="cost-percentage-diff" class="widget-diff-value"></div>
                        <div id="cost-percentage-diff-percent" class="widget-diff-percent"></div>
                    </div>
                    <div class="widget-prev d-flex">
                        <div class="widget-prev-title"></div>
                        <div id="cost-percentage-prev" class="widget-prev-value"></div>
                    </div>
                </div>
            </div>
            <div class="col-6">
                <div class="widget">
                    <div class="widget-title"><i class="bi bi-book red"></i>Công nợ khách hàng:</div>
                    <div id="customer-debt" class="widget-value"></div>
                </div>
            </div>
            <div class="col-6">
                <div class="widget">
                    <div class="widget-title"><i class="bi bi-cash green"></i>Tổng chi phí:</div>
                    <div id="total-cost" class="widget-value"></div>
                    <div class="d-flex widget-diff">
                        <div id="total-cost-diff" class="widget-diff-value"></div>
                        <div id="total-cost-diff-percent" class="widget-diff-percent"></div>
                    </div>
                    <div class="widget-prev d-flex">
                        <div class="widget-prev-title"></div>
                        <div id="total-cost-prev" class="widget-prev-value"></div>
                    </div>
                </div>
            </div>
            <div class="col-6">
                <div class="widget">
                    <div class="widget-title"><i class="bi bi-cash-coin blue"></i>Lợi nhuận ròng</div>
                    <div id="total-profit" class="widget-value"></div>
                    <div class="d-flex widget-diff">
                        <div id="total-profit-diff" class="widget-diff-value"></div>
                        <div id="total-profit-diff-percent" class="widget-diff-percent"></div>
                    </div>
                    <div class="widget-prev d-flex">
                        <div class="widget-prev-title"></div>
                        <div id="total-profit-prev" class="widget-prev-value"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<script>
    let isShowingPassword = false;
    pageTitle = "UNI COFFEE";
    var reportMonths = @Html.Raw(Json.Serialize(Model.ReportMonths));
    var month = 1;
    var year = 2026;
    var customerSelectBox;
    
    $(function () {
        if (isAdmin) {
            const topSection = $("#top-section");
            customerSelectBox = appendSelectField({ id: "customer-select-box", container: topSection, width: "10.4rem", title: "Tháng", dataSource: reportMonths, onValueChanged: monthChanged });
            customerSelectBox.option("value", reportMonths[0].Id);

        } else {
            let textEditorContainer = $("#password .dx-texteditor-container");
            console.log(textEditorContainer);
            textEditorContainer.append(`<div class='d-flex align-items-center'><a id='eye-link' href='#' onclick='showHidePassword()'><i class="bi bi-eye"></i></a></div>`);

            setTimeout(() => {
                updateTextBoxBackground();
            }, "500");
        }
    });

    function monthChanged(e) {
        let monthString = e.value;
        month = e.value % 100;
        year = (e.value - month) / 100;
        console.log("monthChanged", month, year);
        loadReport();
    }

    function loadReport() {
        console.log("loadReport", month, year);
        $.ajax({
            url: '@Url.Action("GetMonthReport", "Report")',
            method: "POST",
            data: { "month": month, "year": year },
            success: function(result) {
                console.log("Main Report: ", result);
                displayReport(result);
            },
            error: function(xhr, status, error) {
                console.log("xhr", xhr, "status", status, "error", error);
            }
        });
    }

    function displayReport(report) {
        $(".widget-prev-title").text("Tháng " + report.PrevMonth);

        const options = { style: "decimal", maximumFractionDigits: 0, useGrouping: true };
        const numberFormat = new Intl.NumberFormat("en-US", options);

        const options1 = { style: "decimal", maximumFractionDigits: 1, useGrouping: true };
        const numberFormat1 = new Intl.NumberFormat("en-US", options1);

        $("#sales-total").html(numberFormat1.format(report.SalesTotal / 1000000) + "<span class='widget-unit'>tr</span>");
        setDiffText($("#sales-total-diff"), report.SalesTotal / 1000000, report.PrevSalesTotal / 1000000, "tr", numberFormat1);
        setDiffPercentText($("#sales-total-diff-percent"), report.SalesTotal, report.PrevSalesTotal, numberFormat);
        $("#sales-total-prev").html(numberFormat1.format(report.PrevSalesTotal / 1000000) + "<span class='widget-unit'>tr</span>");

        $("#sales-quantity").html(numberFormat1.format(report.SalesQuantity) + "<span class='widget-unit'>kg</span>");
        setDiffText($("#sales-quantity-diff"), report.SalesQuantity, report.PrevSalesQuantity, "kg", numberFormat1);
        setDiffPercentText($("#sales-quantity-diff-percent"), report.SalesQuantity, report.PrevSalesQuantity, numberFormat);
        $("#sales-quantity-prev").html(numberFormat1.format(report.PrevSalesQuantity) + "<span class='widget-unit'>kg</span>");

        $("#cost-percentage").html(numberFormat1.format(report.CostPercentage) + "<span class='widget-unit'>%</span>");
        setDiffText($("#cost-percentage-diff"), report.CostPercentage, report.PrevCostPercentage, "điểm %", numberFormat1);
        setDiffPercentText($("#cost-percentage-diff-percent"), report.CostPercentage, report.PrevCostPercentage, numberFormat);
        $("#cost-percentage-prev").html(numberFormat1.format(report.PrevCostPercentage) + "<span class='widget-unit'>%</span>");

        $("#customer-debt").text(numberFormat.format(report.CustomerDebtTotal) + " đ");

        $("#total-cost").html(numberFormat1.format(report.TotalCost / 1000000) + "<span class='widget-unit'>tr</span>");
        setDiffText($("#total-cost-diff"), report.TotalCost / 1000000, report.PrevTotalCost / 1000000, "tr", numberFormat1, false);
        setDiffPercentText($("#total-cost-diff-percent"), report.TotalCost, report.PrevTotalCost, numberFormat, false);
        $("#total-cost-prev").html(numberFormat1.format(report.PrevTotalCost / 1000000) + "<span class='widget-unit'>tr</span>");

        $("#total-profit").html(numberFormat1.format(report.TotalProfit / 1000000) + "<span class='widget-unit'>tr</span>");
        setDiffText($("#total-profit-diff"), report.TotalProfit / 1000000, report.PrevTotalProfit / 1000000, "tr", numberFormat1);
        setDiffPercentText($("#total-profit-diff-percent"), report.TotalProfit, report.PrevTotalProfit, numberFormat);
        $("#total-profit-prev").html(numberFormat1.format(report.PrevTotalProfit / 1000000) + "<span class='widget-unit'>tr</span>");
    }

    function setDiffText(div, currentValue, prevValue, unit, numberFormat, higherGood) {
        if (higherGood == undefined)
            higherGood = true;

        let diff = currentValue - prevValue;
        let text = numberFormat.format(diff);
        div.removeClass("red");
        div.removeClass("green");
        if (diff > 0) {
            text = "+" + text;
            div.addClass(higherGood ? "green" : "red");
        } else {
            div.addClass(higherGood ? "red" : "green");
        }
        div.html(text + "<span class='widget-unit'>" + unit + "</span>");
    }

    function setDiffPercentText(div, currentValue, prevValue, numberFormat, higherGood) {
        let diff = currentValue - prevValue;
        let text = "";
        if (prevValue > 0) {
            let diffPercent = diff / prevValue * 100;
            text = numberFormat.format(diffPercent);
        }

        div.removeClass("red");
        div.removeClass("green");
        if (diff > 0) {
            if (text != "")
                text = "+" + text;
    
                div.addClass(higherGood ? "green" : "red");
        } else {
            div.addClass(higherGood ? "red" : "green");
        }

        div.html(text + "<span class='widget-unit'>%</span>");
    }

    function formatNumber(number, fractionDigits) {
        if (fractionDigits == undefined)
            fractionDigits = 0;

        const options = { style: "decimal", maximumFractionDigits: fractionDigits, useGrouping: true };
        const numberFormat = new Intl.NumberFormat("en-US", options);
        return numberFormat.format(number);
    }

    function showHidePassword() {
        isShowingPassword = !isShowingPassword;
        let passwordTextBox = $("#password").dxTextBox("instance");
        console.log(passwordTextBox);
        passwordTextBox.option("mode", isShowingPassword ? "text" : "password");
        let eyeLink = $("#eye-link i");
        eyeLink.removeClass(isShowingPassword ? "bi-eye" : "bi-eye-slash");
        eyeLink.addClass(isShowingPassword ? "bi-eye-slash" : "bi-eye");
    }

    function login() {
        $("#button-indicator").dxLoadIndicator("option", "visible", true);
        var form = $("#login-form").dxForm("instance");
        var formData = form.option('formData');
        $.ajax({
            url: '@Url.Action("Post", "Token")',
            method: "POST",
            data: formData,
            success: function (result) {
                // location.href = "/customer";
                location.reload()
            },
            error: function (xhr, status, error) {
                console.log("xhr", xhr, "status", status, "error", error);
                $("#button-indicator").dxLoadIndicator("option", "visible", false);
                DevExpress.ui.dialog.alert("Đăng nhập không thành công.", "Cảnh báo");
            }
        });
    }
</script>